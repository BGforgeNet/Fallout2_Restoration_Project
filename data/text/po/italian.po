msgid "Here comes the Porkchop Express."
msgstr "Ecco a voi il Porkchop Express."

#: game/cmbatai2.msg:32624 game/combatai.msg:32624
msgid "We warned you..."
msgstr "Ti avevamo avvertito..."

#: game/cmbatai2.msg:32625 game/combatai.msg:32625
msgid "One ex-gaijin, coming up!"
msgstr "Un ex-gaijin, eccolo!"

#: game/cmbatai2.msg:32626 game/combatai.msg:32626
msgid "Goodbye, dead one."
msgstr "Arrivederci, morituro."

#: game/cmbatai2.msg:32640 game/combatai.msg:32640

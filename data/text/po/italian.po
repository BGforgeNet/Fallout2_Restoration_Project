#: dialog/ncperson.msg:722
msgid "Fortune's against me."
msgstr "La Fortuna e' contro di me."

#: dialog/nccaspat.msg:291
msgid "Lady Luck, don't fail me now."
msgstr "Madama Fortuna, non tradirmi proprio adesso."

#: dialog/nccaspat.msg:292 dialog/ncperson.msg:342 dialog/ncperson.msg:408
#: dialog/ncperson.msg:470
msgid "The House ha'mercy on me."
msgstr "Il Casino' ha avuto pieta' di me."

#: dialog/nccaspat.msg:293
msgid "Between tips and these drunken spending sprees..."
msgstr "Ci sono un sacco di novellini e di giocatori ubriachi, oggi…"

#: dialog/nccaspat.msg:294
msgid "Keep betting like that, and you're going to be calling Golgotha home..."
msgstr ""

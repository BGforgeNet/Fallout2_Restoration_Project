#: dialog/nccasbou.msg:296 dialog/nccasbou.msg:315
msgid "Welcome to the casino, ma'am."
msgstr "Benvenuta al casino', signora."

#: dialog/nccasbou.msg:297 dialog/nccasbou.msg:316

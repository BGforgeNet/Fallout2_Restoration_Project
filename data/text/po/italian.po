msgid "hit randomly"
msgstr "ha colpito alla cieca"

#: game/combat.msg:221 game/combat.msg:321
msgid "crippled a random limb"
msgstr "ha ferito un arto a caso"

#: game/combat.msg:222 game/combat.msg:322
msgid "peppered with fragments"
msgstr "e' stata colpita dai frammenti"


#: dialog/nccasbou.msg:298
msgid "No problems today, ma'am."
msgstr "Oggi nessun problema, signora."

#: dialog/nccasbou.msg:299
msgid "Uh, is there a problem, ma'am? Or just visiting?"
msgstr ""

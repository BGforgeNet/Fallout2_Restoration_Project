msgstr "Cerchi un buco dove impiantare il paletto?"

#: dialog/ncprosti.msg:420 dialog/ncprosti.msg:610 dialog/ncprosti.msg:773
#: dialog/ncprosti.msg:1004 dialog/ncprosti.msg:1179 dialog/ncprosti.msg:1352
msgid "Wanna make me moan?"
msgstr "Vuoi farmi urlare di piacere?"

#: dialog/ncprosti.msg:421 dialog/ncprosti.msg:611 dialog/ncprosti.msg:774
#: dialog/ncprosti.msg:1005 dialog/ncprosti.msg:1180 dialog/ncprosti.msg:1353
msgid "::Purrrrr::"
msgstr "::Purrrrr::"

#: dialog/ncprosti.msg:422 dialog/ncprosti.msg:612 dialog/ncprosti.msg:775
#: dialog/ncprosti.msg:1006 dialog/ncprosti.msg:1181 dialog/ncprosti.msg:1354
msgid "::Rrrrrowrrr::"
msgstr "::Rrrrrowrrr::"

#: dialog/ncprosti.msg:423 dialog/ncprosti.msg:613 dialog/ncprosti.msg:776
msgid "::Blows you a kiss::"
msgstr "::Ti manda un bacio::"

#: dialog/ncprosti.msg:424
msgid "Wanna get together?"
msgstr "Vuoi venire a letto con me?"

#: dialog/ncprosti.msg:425 dialog/ncprosti.msg:615 dialog/ncprosti.msg:778
#: dialog/ncprosti.msg:924 dialog/ncprosti.msg:1010 dialog/ncprosti.msg:1185
#: dialog/ncprosti.msg:1268 dialog/ncprosti.msg:1358
msgid "I'm not cheap, but I am on special."
msgstr "Non costo poco, ma sono speciale."

#: dialog/ncprosti.msg:426 dialog/ncprosti.msg:616 dialog/ncprosti.msg:779
#: dialog/ncprosti.msg:1011 dialog/ncprosti.msg:1186 dialog/ncprosti.msg:1359
msgid "Tying you up costs extra."
msgstr "Se vuoi che ti leghi, ti costera' un extra."

#: dialog/ncprosti.msg:427 dialog/ncprosti.msg:617 dialog/ncprosti.msg:780
#: dialog/ncprosti.msg:1012 dialog/ncprosti.msg:1187 dialog/ncprosti.msg:1360
msgid "Where did I leave my whip?"
msgstr "Dove ho lasciato la mia frusta?"

#: dialog/ncprosti.msg:428 dialog/ncprosti.msg:618 dialog/ncprosti.msg:781
#: dialog/ncprosti.msg:1013 dialog/ncprosti.msg:1188 dialog/ncprosti.msg:1361
msgid "Ready like a freddie."
msgstr "Sono pronta per te."

#: dialog/ncprosti.msg:429 dialog/ncprosti.msg:619 dialog/ncprosti.msg:782
#: dialog/ncprosti.msg:1014 dialog/ncprosti.msg:1189 dialog/ncprosti.msg:1362
msgid "I had to dress up like WILMA last night, fer Chrissakes."
msgstr "Mi sono dovuta vestire da WILMA la scorsa notte, cristosanto."

#: dialog/ncprosti.msg:430 dialog/ncprosti.msg:620 dialog/ncprosti.msg:783
#: dialog/ncprosti.msg:1015 dialog/ncprosti.msg:1190 dialog/ncprosti.msg:1363
msgid "I was with Myron last night. For about five seconds."
msgstr "Sono stata con Myron ieri notte. Per circa cinque secondi."

#: dialog/ncprosti.msg:431 dialog/ncprosti.msg:622 dialog/ncprosti.msg:785
#: dialog/ncprosti.msg:1017 dialog/ncprosti.msg:1192
msgid "Wish they'd come out with some Jet-smelling body oils..."
msgstr "Vorrei tanto che inventassero degli olii balsamici all'aroma di Jet..."

#: dialog/ncprosti.msg:432 dialog/ncprosti.msg:624 dialog/ncprosti.msg:787
#: dialog/ncprosti.msg:1019 dialog/ncprosti.msg:1194 dialog/ncprosti.msg:1367
msgid "My ass is going to fall off, Myron keeps it up."
msgstr ""
"Myron ha qualche problema... una volta e' venuto non appena ho bussato alla "
"sua porta."

#: dialog/ncprosti.msg:433 dialog/ncprosti.msg:625 dialog/ncprosti.msg:788
#: dialog/ncprosti.msg:1020 dialog/ncprosti.msg:1195 dialog/ncprosti.msg:1368
msgid "Damn Temperance Union came around again..."
msgstr "Quella dannata Associazione Sobrieta' si e' fatta di nuovo viva..."

#: dialog/ncprosti.msg:435 dialog/ncprosti.msg:628 dialog/ncprosti.msg:791
#: dialog/ncprosti.msg:1024 dialog/ncprosti.msg:1199 dialog/ncprosti.msg:1372
msgid "I guarantee I'm better than that Pip-Boy attachment you've been using."
msgstr ""
"Ti garantisco che sono meglio di quell'accessorio del Pip Boy che usi tu."

#: dialog/ncprosti.msg:436
msgid "Want me to tighten your screws, slaver?"
msgstr "Vuoi che ti aiuti a stringere la tua vite, Schiavista?"

#: dialog/ncprosti.msg:437 dialog/ncprosti.msg:630 dialog/ncprosti.msg:793
#: dialog/ncprosti.msg:1026 dialog/ncprosti.msg:1201 dialog/ncprosti.msg:1374
msgid "I'd rather be with Avellone."
msgstr "Preferirei essere con Avellone."

#: dialog/ncprosti.msg:438 dialog/ncprosti.msg:631 dialog/ncprosti.msg:794
#: dialog/ncprosti.msg:1027 dialog/ncprosti.msg:1202 dialog/ncprosti.msg:1375
msgid "I wish Nick Kesting was here. We could talk for hours!"
msgstr "Vorrei tanto che Nick Kesting fosse qui. Potremmo parlare per ore!"

#: dialog/ncprosti.msg:439 dialog/ncprosti.msg:632 dialog/ncprosti.msg:795
#: dialog/ncprosti.msg:1028 dialog/ncprosti.msg:1203 dialog/ncprosti.msg:1376
msgid "Nick Kesting is a really nice guy. We have great conversations."
msgstr ""
"Nick Kesting e' davvero un bravo ragazzo. Facciamo dei cosi' bei discorsi."

#: dialog/ncprosti.msg:440 dialog/ncprosti.msg:633 dialog/ncprosti.msg:796
#: dialog/ncprosti.msg:1029 dialog/ncprosti.msg:1204 dialog/ncprosti.msg:1377
msgid "Tommy the Balls is sooo dreamy."
msgstr "Tommy the Balls e' magniFico."

#: dialog/ncprosti.msg:441 dialog/ncprosti.msg:797 dialog/ncprosti.msg:927
#: dialog/ncprosti.msg:1273
msgid "Well, well. Look who just rolled into town..."
msgstr "Bene, bene. Guardate chi e' arrivato in citta'..."

#: dialog/ncprosti.msg:442
msgid "You look like someone with some time to burn."
msgstr "Hai l'aspetto di uno che ha del tempo da perdere."

#: dialog/ncprosti.msg:443 dialog/ncprosti.msg:568 dialog/ncprosti.msg:731
msgid "Oh, boy! A tourist!"
msgstr "Oh, cavoli! Un turista!"

#: dialog/ncprosti.msg:444 dialog/ncprosti.msg:627 dialog/ncprosti.msg:790
#: dialog/ncprosti.msg:1023 dialog/ncprosti.msg:1198 dialog/ncprosti.msg:1371
msgid "Biting is extra."
msgstr "I morsi sono un extra."

#: dialog/ncprosti.msg:445 dialog/ncprosti.msg:1031
msgid "My name's Easy, slaver-girl. What's yours?"
msgstr "Il mio nome e' Facile, ragazza-schiavista. Qual e' il tuo?"

#: dialog/ncprosti.msg:446
msgid "Hey, slaver-girl. Looking for the other woman?"
msgstr "Ehi, ragazza-schiavista. Cerchi un'altra donna?"

#: dialog/ncprosti.msg:447 dialog/ncprosti.msg:639 dialog/ncprosti.msg:802
#: dialog/ncprosti.msg:1035 dialog/ncprosti.msg:1208 dialog/ncprosti.msg:1381
msgid "Looking for a taste of the other side, sweetheart?"
msgstr "Vuoi assaggiare l'altra meta' del cielo, dolcezza?"

#: dialog/ncprosti.msg:448
msgid "Need a \"slave\" for the evening, slaver-girl?"
msgstr "Ti serve una \"schiava\" per stasera, ragazza-schiavista?"

#: dialog/ncprosti.msg:449
msgid "Need someone to warm your tent, slaver-girl?"
msgstr "Hai bisogno di qualcuno che ti riscaldi la tenda, ragazza-schiavista?"

#: dialog/ncprosti.msg:450 dialog/ncprosti.msg:1040
msgid "Need someone to share your bedroll, slaver-girl?"
msgstr "Cerchi qualcuno con cui dividere il sacco a pelo, ragazza-schiavista?"

#: dialog/ncprosti.msg:451 dialog/ncprosti.msg:1042
msgid "Wanna dance, slaver-girl?"
msgstr "Vuoi ballare, ragazza-schiavista?"

#: dialog/ncprosti.msg:452 dialog/ncprosti.msg:1043
msgid "Slaver-girl, you ain't never had love 'til you had Reno love."
msgstr ""
"Ragazza-schiavista, non puoi dire di aver fatto davvero l'amore prima di "
"averlo fatto qui a Reno."

#: dialog/ncprosti.msg:453
msgid "Wanna fly, slaver-girl?"
msgstr "Vuoi farti un giro, ragazza-schiavista?"

#: dialog/ncprosti.msg:454 dialog/ncprosti.msg:1045
msgid "Lose your way, slaver-girl?"
msgstr "Hai perso la via, ragazza-schiavista?"

#: dialog/ncprosti.msg:455 dialog/ncprosti.msg:1046
msgid "Looking for a good time, slaver-girl?"
msgstr "Ti vuoi divertire un po', ragazza-schiavista?"

#: dialog/ncprosti.msg:456
msgid "Didn't realize the slaver guild had women now..."
msgstr "Non sapevo che la gilda degli Schiavisti avesse delle donne..."

#: dialog/ncprosti.msg:457 dialog/ncprosti.msg:1048
msgid "Where's the fire, slaver-girl?"
msgstr "E' qui la festa, ragazza-schiavista?"

#: dialog/ncprosti.msg:458
msgid "That slaver girl's pretty foxy."
msgstr "Quella ragazza schiavista e' davvero sexy."

#: dialog/ncprosti.msg:459
msgid "That slaver-girl makes my Geiger counter tick."
msgstr "Quella ragazza schiavista fa ticchettare il mio contatore Geiger."

#: dialog/ncprosti.msg:460
msgid ""
"I guarantee I'm better in the sack than that robot following you around."
msgstr ""
"Ti garantisco che sono piu' brava a letto io di quel robot che ti segue."

#: dialog/ncprosti.msg:461
msgid "Is that robot FULLY functional?"
msgstr "Quel robot ha TUTTE le funzioni?"

#: dialog/ncprosti.msg:466
msgid "That mutant'll be extra. LOTS extra."
msgstr "Per quel mutante dovrai pagare un extra. Un GROSSO extra."

#: dialog/ncprosti.msg:467
msgid "Uh-oh. Mutants in New Reno. Must mean trouble."
msgstr "Uh-oh. Mutanti a New Reno. Guai in arrivo."

#: dialog/ncprosti.msg:469
msgid "That mutant looks like he could crush me in one hand. Hmmmnnn."
msgstr "Quel mutante potrebbe schiacciarmi con una mano sola. Hmmmnnn."

#: dialog/ncprosti.msg:470
msgid "I wouldn't even know what to charge for a mutant."
msgstr "Non saprei neanche dire quale sia il prezzo per un mutante."

#: dialog/ncprosti.msg:471
msgid "Hey, Myron!"
msgstr "Ehi, Myron!"

#: dialog/ncprosti.msg:472
msgid "Myron! Honey! When are you going to come back and see lil' ol me?"
msgstr "Myron! Zucchero! Quand'e' che verrai a trovarmi?"

#: dialog/ncprosti.msg:473
msgid "My-ron. Myyyyyy-ron."
msgstr "My-ron. Myyyyyy-ron."

#: dialog/ncprosti.msg:474
msgid "Myron, who's your cute friend?"
msgstr "Myron, chi e' il tuo amichetto carino?"

#: dialog/ncprosti.msg:475
msgid "Myron, honey! Myron! You looking for some action?"
msgstr "Myron, tesoro! Myron! Cerchi un po' di divertimento?"

#: dialog/ncprosti.msg:476
msgid "Yoo-hoo! Myron!"
msgstr "Yoo-hoo! Myron!"

#: dialog/ncprosti.msg:477
msgid "I been missing you, Myron!"
msgstr "Mi sei mancato, Myron!"

#: dialog/ncprosti.msg:478
msgid "Myron, you are sooooo dreamy. Well, sort of."
msgstr "Myron, sei coooosi' figo. Beh, piu' o meno."

#: dialog/ncprosti.msg:479
msgid "Myron, when are you gonna see me again?"
msgstr "Myron, quand'e' che tornerai a trovarmi?"

#: dialog/ncprosti.msg:480
msgid "Can you get me some Jet, Myron?"
msgstr "Puoi darmi un po' di Jet, Myron?"

#: dialog/ncprosti.msg:481
msgid "When are you gonna set me up with some Jet, Myron?"
msgstr "Quand'e' che mi darai un po' di Jet, Myron?"

#: dialog/ncprosti.msg:482
msgid "Can you help me fly, Myron?"
msgstr "Puoi aiutarmi a volare, Myron?"

#: dialog/ncprosti.msg:483 dialog/ncprosti.msg:655 dialog/ncprosti.msg:1050
#: dialog/ncprosti.msg:1223
msgid "My name's Easy. What's yours?"
msgstr "Il mio nome e' Facile. Qual e' il tuo?"

#: dialog/ncprosti.msg:484 dialog/ncprosti.msg:640 dialog/ncprosti.msg:656
#: dialog/ncprosti.msg:803 dialog/ncprosti.msg:1209 dialog/ncprosti.msg:1382
msgid "Need a little company?"
msgstr "Vuoi un po' di compagnia?"

#: dialog/ncprosti.msg:486 dialog/ncprosti.msg:658 dialog/ncprosti.msg:1058
#: dialog/ncprosti.msg:1231
msgid "Need someone to warm your tent?"
msgstr "Cerchi qualcuno che ti riscaldi la tenda?"

#: dialog/ncprosti.msg:487 dialog/ncprosti.msg:659 dialog/ncprosti.msg:1059
#: dialog/ncprosti.msg:1232
msgid "Need someone to share your bedroll?"
msgstr "Cerchi qualcuno con cui dividere il sacco a pelo?"

#: dialog/ncprosti.msg:488 dialog/ncprosti.msg:660 dialog/ncprosti.msg:1060
#: dialog/ncprosti.msg:1233
msgid "Got some hot-rocks there, pal."
msgstr "Hai dei bei sassolini li' sotto, amico."

#: dialog/ncprosti.msg:491 dialog/ncprosti.msg:523 dialog/ncprosti.msg:663
#: dialog/ncprosti.msg:695 dialog/ncprosti.msg:890 dialog/ncprosti.msg:1063
#: dialog/ncprosti.msg:1070 dialog/ncprosti.msg:1236 dialog/ncprosti.msg:1243
msgid "You ain't never had love 'til you had Reno love."
msgstr ""
"Non puoi dire di aver fatto davvero l'amore prima di averlo fatto qui a Reno."

#: dialog/ncprosti.msg:495 dialog/ncprosti.msg:667 dialog/ncprosti.msg:895
#: dialog/ncprosti.msg:1068 dialog/ncprosti.msg:1241
msgid "Only sports going on in Reno nowdays in tonsil hockey..."
msgstr "L'unico sport che si vede a Reno ultimamente e' il Tonsill-Hockey..."

#: dialog/ncprosti.msg:497 dialog/ncprosti.msg:669 dialog/ncprosti.msg:923
#: dialog/ncprosti.msg:945 dialog/ncprosti.msg:1119 dialog/ncprosti.msg:1267
#: dialog/ncprosti.msg:1292
msgid "Forget the slot machines. My payoff's MUCH better."
msgstr "Dimentica le slot machine. Il mio jackpot e' MOLTO piu' alto."

#: dialog/ncprosti.msg:498 dialog/ncprosti.msg:670 dialog/ncprosti.msg:898
#: dialog/ncprosti.msg:1123 dialog/ncprosti.msg:1296
msgid "I can't believe how many strippers were at Feargus' bachelor party."
msgstr ""
"Non riesco a credere quante spogliarelliste c’erano all’addio al celibato di "
"Feargus."

#: dialog/ncprosti.msg:499 dialog/ncprosti.msg:671
msgid "New stranger in town, looks like..."
msgstr "Pare ci sia un nuovo straniero in citta'..."

#: dialog/ncprosti.msg:501 dialog/ncprosti.msg:673 dialog/ncprosti.msg:903
#: dialog/ncprosti.msg:1075 dialog/ncprosti.msg:1248
msgid "Wanna fly?"
msgstr "Vuoi volare?"

#: dialog/ncprosti.msg:502
msgid "Haven't seen any caravans from Redding in a while."
msgstr "E' da un po' che non vedo carovane provenienti da Redding."

#: dialog/ncprosti.msg:505 dialog/ncprosti.msg:677 dialog/ncprosti.msg:1078
#: dialog/ncprosti.msg:1251
msgid "Lose your way, cowboy?"
msgstr "Hai perso la via, cowboy?"

#: dialog/ncprosti.msg:506 dialog/ncprosti.msg:678 dialog/ncprosti.msg:1079
#: dialog/ncprosti.msg:1252
msgid "Got a gun you need to unload, soldier?"
msgstr "Hai una pistola da scaricare, soldato?"

#: dialog/ncprosti.msg:508 dialog/ncprosti.msg:680
msgid "Too many streetwalkers in this town, not enough chips to go around."
msgstr "Troppe camminatrici in questa citta' e non abbastanza denaro per tutte."

#: dialog/ncprosti.msg:509
msgid "I've been walking this street since last night..."
msgstr "Cammino su questa strada da ieri notte..."

#: dialog/ncprosti.msg:510 dialog/ncprosti.msg:682 dialog/ncprosti.msg:1074
#: dialog/ncprosti.msg:1247
msgid "Need a friend for the evening? Or just ten minutes?"
msgstr "Ti serve un'amica per la serata? O anche per dieci minuti?"

#: dialog/ncprosti.msg:511 dialog/ncprosti.msg:551 dialog/ncprosti.msg:683
#: dialog/ncprosti.msg:714 dialog/ncprosti.msg:948 dialog/ncprosti.msg:984
#: dialog/ncprosti.msg:1081 dialog/ncprosti.msg:1122 dialog/ncprosti.msg:1254
msgid "Looking for a good time?"
msgstr "Ti vuoi divertire un po'?"

#: dialog/ncprosti.msg:512 dialog/ncprosti.msg:684 dialog/ncprosti.msg:986
#: dialog/ncprosti.msg:1082 dialog/ncprosti.msg:1255
msgid "Looking to go down-town?"
msgstr "Ti sei perso?"

#: dialog/ncprosti.msg:513 dialog/ncprosti.msg:685 dialog/ncprosti.msg:1083
#: dialog/ncprosti.msg:1256
msgid "I like the look of your gecko."
msgstr "Mi piace l'aspetto del tuo gecko."

#: dialog/ncprosti.msg:515 dialog/ncprosti.msg:652 dialog/ncprosti.msg:1085
#: dialog/ncprosti.msg:1220 dialog/ncprosti.msg:1258
msgid "You need a guide around town, sugah?"
msgstr "Ti serve una guida per la citta', zuccherino?"

#: dialog/ncprosti.msg:516 dialog/ncprosti.msg:688 dialog/ncprosti.msg:1086
#: dialog/ncprosti.msg:1259 dialog/ncprosti.msg:1365
msgid "Where's the fire?"
msgstr "E' qui la festa?"

#: dialog/ncprosti.msg:518
msgid "Sometimes the way women in this town are designed offends me."
msgstr ""
"A volte mi da' fastidio il modo nel quale sono rappresentate le donne di "
"questa citta'."

#: dialog/ncprosti.msg:520 dialog/ncprosti.msg:692
msgid "That man makes my Geiger counter tick."
msgstr "Quell'uomo fa ticchettare il mio contatore Geiger."

#: dialog/ncprosti.msg:521 dialog/ncprosti.msg:916 dialog/ncprosti.msg:1090
#: dialog/ncprosti.msg:1263
msgid "If I have to talk to you afterwards, that's extra."
msgstr "Se dopo vuoi che ti parli, devi pagarmi un extra."

#: dialog/ncprosti.msg:522 dialog/ncprosti.msg:694 dialog/ncprosti.msg:908
#: dialog/ncprosti.msg:1080 dialog/ncprosti.msg:1253
msgid "Anything I can help you with, stranger?"
msgstr "Posso aiutarti in qualche modo, straniero?"

#: dialog/ncprosti.msg:524 dialog/ncprosti.msg:1092
msgid "Your friend with the bone in his nose... great gimmick."
msgstr "Il tuo amico con l'osso nel naso... gran bel gingillo."

#: dialog/ncprosti.msg:525 dialog/ncprosti.msg:1093
msgid "Does your friend with the bone do tricks with his nose or sumthin'?"
msgstr "Il tuo amico con l'osso fa giochetti con il naso, per caso?"

#: dialog/ncprosti.msg:526 dialog/ncprosti.msg:1094
msgid ""
"Maybe I should put a bone in my nose. Might attract more female customers."
msgstr ""
"Forse dovrei mettermelo anch'io un osso nel naso. Attirerei piu' clienti di "
"sesso femminile."

#: dialog/ncprosti.msg:528 dialog/ncprosti.msg:1096
msgid "I don't even want to know how that boy got that bone in his nose."
msgstr ""
"Non voglio nemmeno sapere come c'e' finito quell'osso nel naso del tuo amico."

#: dialog/ncprosti.msg:529 dialog/ncprosti.msg:1097
msgid "Is your friend with the bone in his nose in the business?"
msgstr "Il tuo amico con l'osso nel naso e' nel giro, per caso?"

#: dialog/ncprosti.msg:530 dialog/ncprosti.msg:1098
msgid "How much does your friend with the bone in his nose charge?"
msgstr "Quanto costa andare con il tuo amico con l'osso nel naso?"

#: dialog/ncprosti.msg:531 dialog/ncprosti.msg:1099
msgid "For thirty chips, I can make that bone in your friend's nose larger."
msgstr ""
"Per trenta dollari, posso far diventare piu' grande l'osso nel naso del tuo "
"amico."

#: dialog/ncprosti.msg:532 dialog/ncprosti.msg:1100
msgid "Your friend with the bone in his nose over-compensating for something?"
msgstr "Il tuo amico con l'osso nel naso cerca di compensare qualcosa?"

#: dialog/ncprosti.msg:534
msgid "Taste of paradise? Ten chips."
msgstr "Un assaggio del paradiso? Dieci dollari."

#: dialog/ncprosti.msg:536 dialog/ncprosti.msg:699 dialog/ncprosti.msg:934
#: dialog/ncprosti.msg:1108 dialog/ncprosti.msg:1281
msgid "Myron's a real twister."
msgstr "Myron e' un vero tormento."

#: dialog/ncprosti.msg:539 dialog/ncprosti.msg:702
msgid "Keep thinking that Reno sign's gonna fall down..."
msgstr "Continuo a pensare che quell'insegna di Reno finira' per cadere..."

#: dialog/ncprosti.msg:542 dialog/ncprosti.msg:705 dialog/ncprosti.msg:938
#: dialog/ncprosti.msg:1112 dialog/ncprosti.msg:1285
msgid ""
"I heard Vault City has only two types of Citizens. Maybe it was some cloning "
"accident."
msgstr ""
"Ho sentito dire che a Vault City ci sono solo due tipi di Cittadini. Forse "
"si e' trattato di un qualche errore di clonazione."

#: dialog/ncprosti.msg:543 dialog/ncprosti.msg:706 dialog/ncprosti.msg:939
#: dialog/ncprosti.msg:1113 dialog/ncprosti.msg:1286
msgid "Felt like I was in a marathon last night..."
msgstr ""
"Sono cosi' stanca che mi pare di aver partecipato ad una maratona, la scorsa "
"notte..."

#: dialog/ncprosti.msg:544 dialog/ncprosti.msg:707 dialog/ncprosti.msg:940
#: dialog/ncprosti.msg:1114 dialog/ncprosti.msg:1287
msgid "Looking for love, honey?"
msgstr "Cerchi l'amore, tesoro?"

#: dialog/ncprosti.msg:545 dialog/ncprosti.msg:708 dialog/ncprosti.msg:942
#: dialog/ncprosti.msg:1116 dialog/ncprosti.msg:1289
msgid "Wish Myron would move away. Far away."
msgstr "Vorrei che Myron partisse per un viaggio. Un lungo viaggio."

#: dialog/ncprosti.msg:546 dialog/ncprosti.msg:709 dialog/ncprosti.msg:1117
#: dialog/ncprosti.msg:1290
msgid "I can do ANYTHING you want... for the right price."
msgstr "Posso fare QUALSIASI cosa tu voglia... se il prezzo e' giusto."

#: dialog/ncprosti.msg:547 dialog/ncprosti.msg:710 dialog/ncprosti.msg:944
#: dialog/ncprosti.msg:1118 dialog/ncprosti.msg:1291
msgid "I'm ready to go, honey. How about you?"
msgstr "Sono pronta ad andare, tesoro. E tu?"

#: dialog/ncprosti.msg:550 dialog/ncprosti.msg:636 dialog/ncprosti.msg:713
#: dialog/ncprosti.msg:799 dialog/ncprosti.msg:1121 dialog/ncprosti.msg:1294
msgid "Take a gamble on me, honey."
msgstr "Fai una scommessa su di me, tesoro."

#: dialog/ncprosti.msg:561 dialog/ncprosti.msg:724 dialog/ncprosti.msg:1132
#: dialog/ncprosti.msg:1305
msgid "I've got a girlfriend if you want a double-header."
msgstr "Ho un'amica, se credi che due teste siano meglio di una."

#: dialog/ncprosti.msg:566 dialog/ncprosti.msg:729
msgid "Buy a girl a drink?"
msgstr "Che ne dici di comprare da bere a questa ragazza?"

#: dialog/ncprosti.msg:567 dialog/ncprosti.msg:730 dialog/ncprosti.msg:1137
#: dialog/ncprosti.msg:1310
msgid "Take a lonely lady on the town?"
msgstr "Cerchi una ragazza di citta'?"

#: dialog/ncprosti.msg:569 dialog/ncprosti.msg:732
msgid "Come over here, honey, the show's about to begin..."
msgstr "Vieni qua, tesoro, lo spettacolo sta per cominciare..."

#: dialog/ncprosti.msg:571
msgid "Hellooooo, stranger."
msgstr "Ehilaaa', straniero."

#: dialog/ncprosti.msg:575
msgid "I wish those tribals would go to some other town."
msgstr "Avrei preferito che quei selvaggi se ne andassero in un'altra citta'."

#: dialog/ncprosti.msg:579
msgid "The buzzing of the neon keeps driving me crazy..."
msgstr "Il rumore del neon mi fara' impazzire..."

#: dialog/ncprosti.msg:581 dialog/ncprosti.msg:744
msgid "To think I came from the Den for this..."
msgstr "E pensare che sono arrivata dal Den per questo..."

#: dialog/ncprosti.msg:582 dialog/ncprosti.msg:745
msgid "Hey, stranger! Need a guide?"
msgstr "Ehi, straniero! Ti serve una guida?"

#: dialog/ncprosti.msg:590 dialog/ncprosti.msg:753 dialog/ncprosti.msg:983
#: dialog/ncprosti.msg:1158 dialog/ncprosti.msg:1331
msgid "Wanna waste some time?"
msgstr "Vuoi perdere un po' di tempo?"

#: dialog/ncprosti.msg:594 dialog/ncprosti.msg:757 dialog/ncprosti.msg:1162
#: dialog/ncprosti.msg:1335

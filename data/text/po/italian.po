#: dialog/wsterm2b.msg:121 dialog/wsterm2b.msg:126 dialog/wsterm2b.msg:129
#: dialog/wsterm2b.msg:132 dialog/wsterm2b.msg:140 dialog/wsterm2b.msg:154
#: dialog/wsterm2b.msg:157 dialog/wsterm2b.msg:160 dialog/wsterm2b.msg:163
#: dialog/wsterm4c.msg:123 dialog/wsterm4c.msg:233
msgid "Return to Main Menu"
msgstr "Ritorna al Menu Principale"

#: dialog/epai2.msg:106
msgid ""
"Diagnostic Check... circuit board error....section four... loose wiring."
msgstr ""
"Controllo diagnostico... errore nella scheda di circuito... sezione "
"quattro... cablaggio allentato."

#: dialog/epai2.msg:107 dialog/shtandi.msg:314 game/custom.msg:10
msgid "Done"
msgstr "Fatto"

#: dialog/epai2.msg:108
msgid "It's too difficult to repair this."
msgstr "E' troppo difficile ripararlo."

#: dialog/epai2.msg:109
msgid ""
"The fault in the computer is repaired and the machine is brought back online."
msgstr "Il guasto nel computer viene riparato e la macchina torna online."

#: dialog/epai2.msg:110
msgid ""
"Welcome to the EPA Robot Control Computer. You no longer have security "
"authorization to use these files. Terminating sequence."
msgstr ""
"Benvenuto nel Computer di Controllo dei Robot dell'EPA. Non hai piu' "
"l'autorizzazione di sicurezza per usare questi file. Sequenza terminata."


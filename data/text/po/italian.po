msgid "BEEP!"
msgstr "BEEP!"

#: dialog/epai2.msg:113
msgid "BOOP!"
msgstr "BOOP!"

#: dialog/epai2.msg:114
msgid "Bzzzt.."
msgstr "Bzzzt.."

#: dialog/epai2.msg:115
msgid "You already repaired it."
msgstr "Lo hai gia' riparato."

#: dialog/epai20.msg:100
msgid "Incorrect password. Locking system."
msgstr "Password errata. Blocco del sistema in corso."


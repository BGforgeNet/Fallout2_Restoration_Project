#: game/pro_scen.msg:74901 game/pro_scen.msg:75001 game/pro_scen.msg:75101
#: game/pro_scen.msg:75201 game/pro_scen.msg:75301 game/pro_scen.msg:75401
#: game/pro_scen.msg:75501 game/pro_scen.msg:75601 game/pro_scen.msg:75701
#: game/pro_scen.msg:75801 game/pro_scen.msg:75901 game/pro_scen.msg:76001
msgid "The amount of goo on this computer makes it very difficult to access."
msgstr ""
"La quantita' di gelatina su questo computer lo rende molto difficile da "
"utilizzare."

#: game/pro_scen.msg:76100 game/pro_scen.msg:76200 game/pro_scen.msg:76300
#: game/pro_scen.msg:76400 game/pro_scen.msg:78800 game/pro_scen.msg:78900
#: game/pro_scen.msg:79000 game/pro_scen.msg:79100 game/pro_scen.msg:80000
#: game/pro_scen.msg:80100 game/pro_scen.msg:82300 game/pro_scen.msg:82400
msgid "Monitors"
msgstr "Monitor"

#: game/pro_scen.msg:76101 game/pro_scen.msg:76201 game/pro_scen.msg:76301
#: game/pro_scen.msg:76401
msgid ""
"You cannot read anything on the monitor due to the amount of goo splashed "
"across the screens."
msgstr ""
"Non riesci a leggere nulla sul monitor a causa della quantita' di gelatina "
"spalmata sugli schermi."

#: game/pro_scen.msg:76500 game/pro_scen.msg:76600
msgid "UNUSED ART"
msgstr "ARTE NON UTILIZZATA"

#: game/pro_scen.msg:76800
msgid "Bomb"
msgstr "Bomba"

#: game/pro_scen.msg:76801
msgid "This is a nuclear bomb. It looks very dangerous just sitting there."
msgstr "Questa e' una bomba atomica. Anche il solo guardarla sembra pericoloso."

#: game/pro_scen.msg:76900
msgid "Support Base"
msgstr "Base di Supporto"

#: game/pro_scen.msg:76901
msgid "This base cradles the nuclear bomb that is sitting on it."
msgstr "Questa base sostiene la bomba atomica che ci sta sopra."

#: game/pro_scen.msg:77001
msgid ""
"This is a nuclear access computer. The computer looks very secure. There is "
"a slot for a strangely shaped key."
msgstr ""
"Questo e' un computer di accesso alla bomba atomica. Il computer sembra "
"molto sicuro. C'e' un foro per una strana chiave."

#: game/pro_scen.msg:77100
msgid "Wires"
msgstr "Cavi"

#: game/pro_scen.msg:77101
msgid "These wires are connecting the bomb to the computer."
msgstr "Questi cavi collegano la bomba al computer."

#: game/pro_scen.msg:77201 game/pro_scen.msg:77301 game/pro_scen.msg:77401
#: game/pro_scen.msg:77501 game/pro_scen.msg:77601 game/pro_scen.msg:77701
#: game/pro_scen.msg:77801 game/pro_scen.msg:77901
msgid "There is nothing unusual about this chair."
msgstr "Non c'e' niente di strano riguardo a questa sedia."

#: game/pro_scen.msg:78000 game/pro_scen.msg:78100 game/pro_scen.msg:78200
#: game/pro_scen.msg:78300 game/pro_scen.msg:82900 game/pro_wall.msg:84400
msgid "Pillar"
msgstr "Obelisco"

#: game/pro_scen.msg:78001 game/pro_scen.msg:78101 game/pro_scen.msg:78201
#: game/pro_scen.msg:78301
msgid "A support pillar."
msgstr "Un pilastro di supporto."

#: game/pro_scen.msg:78401
msgid "This bed is in wretched condition."
msgstr "Questo letto e' in condizioni pietose."

#: game/pro_scen.msg:78501
msgid "This bed is in very poor condition."
msgstr "Questo letto e' ridotto molto male."

#: game/pro_scen.msg:78601
msgid "This bed is in poor condition."
msgstr "Questo letto e' ridotto male."

#: game/pro_scen.msg:78701
msgid "This bed is in pretty bad condition."
msgstr "Questi letto e' ridotto piuttosto male."

#: game/pro_scen.msg:78801 game/pro_scen.msg:78901 game/pro_scen.msg:79001
#: game/pro_scen.msg:79101
msgid "These monitors are broken and cannot function."
msgstr "Questi monitor sono rotti e non possono funzionare."

#: game/pro_scen.msg:79201
msgid "Very little fresh air is coming from this vent."
msgstr "Poca aria fresca proviene da questa presa."

#: game/pro_scen.msg:79301
msgid "Almost no fresh air is coming from this vent."
msgstr "Non c'e' praticamente aria fresca uscente da questa presa."

#: game/pro_scen.msg:79401
msgid "No fresh air is coming from this vent."
msgstr "Neanche un po' di aria fresca esce da questa presa."

#: game/pro_scen.msg:79501
msgid "Just a tiny amount of fresh air is coming from this vent."
msgstr "Solo un po' di aria fresca esce da questa presa."

#: game/pro_scen.msg:79601
msgid ""
"There is nothing unusual about this table, except that it is almost "
"destroyed."
msgstr ""
"Non c'e' niente di strano in questo tavolo, se si esclude il fatto che e' "
"praticamente distrutto."

#: game/pro_scen.msg:79701
msgid "This table was badly damaged."
msgstr "Questo tavolo e' molto danneggiato."

#: game/pro_scen.msg:79801
msgid "This table is in very poor condition."
msgstr "Questo tavolo e' ridotto molto male."

#: game/pro_scen.msg:79901
msgid "There is no reason to search this table."
msgstr "Non c'e' motivo di setacciare questo tavolo."

#: game/pro_scen.msg:80001
msgid "The display screens in this bank of monitors have been destroyed."
msgstr "Gli schermi di questo gruppo di monitor sono stati distrutti."

#: game/pro_scen.msg:80101
msgid ""
"The display screens in this bank of monitors have been damaged beyond repair."
msgstr ""
"Gli schermi di questo gruppo di monitor sono stati danneggiati "
"irreparabilmente."

#: game/pro_scen.msg:80201
msgid "The monitor screen is cracked and destroyed."
msgstr "Lo schermo del monitor e' crepato e distrutto."

#: game/pro_scen.msg:80301
msgid "This monitor is worthless with a broken display screen."
msgstr "Questo monitor e' inutile con lo schermo distrutto."

#: game/pro_scen.msg:80401 game/pro_scen.msg:80501 game/pro_scen.msg:80601
msgid "This computer is broken."
msgstr "Questo computer e' rotto."

#: game/pro_scen.msg:80701 game/pro_scen.msg:80801 game/pro_scen.msg:80901
#: game/pro_scen.msg:81001
msgid "This chair is ruined."
msgstr "Questa sedia e' rovinata."

#: game/pro_scen.msg:81101
msgid "This vent has been damaged beyond repair."
msgstr "Questa presa d'aria e' stata danneggiata irreparabilmente."

#: game/pro_scen.msg:81201
msgid "This vent is very damaged, and cannot be repaired."
msgstr "Questa presa d'aria e' molto danneggiata, e non puo' essere riparata."

#: game/pro_scen.msg:81301
msgid "This vent is not functioning at all."
msgstr "Questa presa d'aria non funziona."

#: game/pro_scen.msg:81401 game/pro_scen.msg:81501
msgid "This computer looks like it is barely functional."
msgstr "Questo computer sembra essere a malapena funzionante."

#: game/pro_scen.msg:81601 game/pro_scen.msg:81701
msgid "The monitor is barely working."
msgstr "Il monitor funziona a malapena."

#: game/pro_scen.msg:81801 game/pro_scen.msg:81901
msgid "The computer is not functioning."
msgstr "Il computer non funziona."

#: game/pro_scen.msg:82001 game/pro_scen.msg:82101
msgid "The monitor is not functioning."
msgstr "Il monitor non funziona."

#: game/pro_scen.msg:82201
msgid ""
"It looks like a very nice doorway. It does the job of holding up a door very "
"well."
msgstr ""
"Sembra un'entrata molto bella. Fa molto bene il suo lavoro di tener su la "
"porta."

#: game/pro_scen.msg:82301 game/pro_scen.msg:82401
msgid "The monitors are in good condition."
msgstr "I monitor sono in buone condizioni."

#: game/pro_scen.msg:82600
msgid "Bank Door"
msgstr "Porta"

#: game/pro_scen.msg:82601
msgid "A very sturdy bank vault door. The door looks very secure."
msgstr "Una porta del vault molto solida. La porta sembra molto sicura."

#: game/pro_scen.msg:82700 game/pro_scen.msg:82800 game/pro_scen.msg:90700
#: game/pro_scen.msg:90800 game/pro_scen.msg:138600
msgid "Light"
msgstr "Leggero"

#: game/pro_scen.msg:82701 game/pro_scen.msg:82801
msgid "A security light."
msgstr "Una luce di sicurezza."

#: game/pro_scen.msg:82901
msgid "Pillar."
msgstr "Pilastro."

#: game/pro_scen.msg:83000 game/pro_scen.msg:83100 game/pro_scen.msg:83200
#: game/pro_scen.msg:83300 game/pro_scen.msg:83400
msgid "Robot Receptacle"
msgstr "Ricettacolo per Robot"

#: game/pro_scen.msg:83001 game/pro_scen.msg:83101 game/pro_scen.msg:83201
#: game/pro_scen.msg:83301 game/pro_scen.msg:83401
msgid ""
"This is a robot recharging bay. When not in service, robots will dock here "
"to shut down and recharge."

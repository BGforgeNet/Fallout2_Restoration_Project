#: game/scrname.msg:307 game/scrname.msg:308 game/scrname.msg:975
msgid "Rocks"
msgstr "Rocce"

#: game/pro_scen.msg:7401
msgid "You study the rocks for a while, but they never move."
msgstr "Studi le rocce per un po', ma non si muovono."

#: game/pro_scen.msg:7501
msgid "You keep a close eye on these rocks, in case they move to attack you."
msgstr "Tieni ben d'occhio queste rocce, in caso si muovano per attaccarti."

#: game/pro_scen.msg:7700 game/pro_scen.msg:8700 game/pro_scen.msg:8800

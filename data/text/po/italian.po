#: game/cmbatai2.msg:36610 game/cmbatai2.msg:36620 game/combatai.msg:36610
#: game/combatai.msg:36620
msgid "Ahhhgh!"
msgstr "Ahhhgh!"

#: game/cmbatai2.msg:36611 game/cmbatai2.msg:36621 game/combatai.msg:36611
#: game/combatai.msg:36621
msgid "Ow! You almost hurt Chosen!"
msgstr "Ow! Hai quasi ferito un Prescelto!"

#: game/cmbatai2.msg:36612 game/cmbatai2.msg:36622 game/cmbatai2.msg:36662
#: game/combatai.msg:36612 game/combatai.msg:36622 game/combatai.msg:36662
msgid "Ahhhgh! I snap your neck for that!"
msgstr "Ahhhgh! Ti spezzero' il collo per questo!"

#: game/cmbatai2.msg:36632 game/combatai.msg:36632
msgid "I kill you for that!"
msgstr "Ti ammazzero' per questo!"

#: game/cmbatai2.msg:36633 game/combatai.msg:36633
msgid "You no hurt me when you dead!"
msgstr "Non mi farai male, quando sarai morto!"

#: game/cmbatai2.msg:36634 game/combatai.msg:36634
msgid "I laugh at your feeble attack!"
msgstr "Me la rido del tuo debole attacco!"

#: game/cmbatai2.msg:36636 game/combatai.msg:36636
msgid "I'm gonna dip you!"
msgstr "Ti immergero' nella Vasca!"

#: game/cmbatai2.msg:36637
msgid "Grrr! You anger me."
msgstr "Grrr! Mi fai arrabbiare."

#: game/cmbatai2.msg:36638 game/combatai.msg:36638
msgid "Agh!"
msgstr "Agh!"

#: game/cmbatai2.msg:36639 game/combatai.msg:36639
msgid "I will return this pain to you!"
msgstr "Ti restituiro' il dolore!"

#: game/cmbatai2.msg:36642 game/combatai.msg:36642
msgid "Hmm, you might be trouble."
msgstr "Hmm, potresti darci dei grattacapi."

#: game/cmbatai2.msg:36643
msgid "Grrr! I look forward to your death."
msgstr "Grrr! Non vedo l'ora di ucciderti."

#: game/cmbatai2.msg:36644 game/combatai.msg:36644
msgid "You can hurt me but you cannot win!"
msgstr "Puoi ferirmi, ma non puoi vincere!"

#: game/cmbatai2.msg:36645 game/combatai.msg:36645
msgid "Ow! That wasn't a good idea to hurt me."
msgstr "Ow! Non e' stata una buona idea quella di colpirmi."

#: game/cmbatai2.msg:36660 game/cmbatai2.msg:36670 game/combatai.msg:36660
#: game/combatai.msg:36670
msgid "Ahhhgh! My leg!"
msgstr "Ahhhgh! La gamba!"

#: game/cmbatai2.msg:36661 game/cmbatai2.msg:36671 game/cmbatai2.msg:36691
#: game/combatai.msg:36661 game/combatai.msg:36671 game/combatai.msg:36691
msgid "You call that pain? I laugh!"
msgstr "E questo lo chiami dolore? Non farmi ridere!"

#: game/cmbatai2.msg:36672 game/combatai.msg:36672
msgid "Ahhhgh! I shall snap your neck for that!"
msgstr "Ahhhgh! Ti spezzero' il collo per questo!"

#: game/cmbatai2.msg:36680 game/combatai.msg:36680
msgid "Ahhhgh! Miserable human! I am blind!"
msgstr "Ahhhgh! Umano miserabile! Sono cieco!"

#: game/cmbatai2.msg:36681 game/combatai.msg:36681
msgid "Ahhhgh! Pain! What have you done!"
msgstr "Ahhhgh! Che male! Che cosa hai fatto?!"

#: game/cmbatai2.msg:36682 game/combatai.msg:36682
msgid "Ahhhgh! I will torture you many days!"
msgstr "Ahhhgh! Ti torturero' per molti giorni!"

#: game/cmbatai2.msg:36690 game/combatai.msg:36690
msgid "That is human weakness!"
msgstr "Questa e' la debolezza umana!"

#: game/cmbatai2.msg:36692 game/combatai.msg:36692
msgid "You are stupid, human!"
msgstr "Sei stupido, umano!"

#: game/cmbatai2.msg:36693 game/cmbatai2.msg:36695 game/combatai.msg:36693
#: game/combatai.msg:36695
msgid "Why you attack me there?"
msgstr "Perche' mi attacchi li'?"

#: game/cmbatai2.msg:36694
msgid "I will hurt you for many hours"
msgstr "Ti colpiro' per molte ore"

#: game/cmbatai2.msg:36701 game/combatai.msg:36701
msgid "You will not kill me!"
msgstr "Non mi ucciderai!"

#: game/cmbatai2.msg:36702 game/combatai.msg:36702
msgid "I will be back!"
msgstr "Tornero'!"

#: game/cmbatai2.msg:36703 game/combatai.msg:36703
msgid "My friends get you for me!"
msgstr "I miei amici ti ammazzeranno per me!"

#: game/cmbatai2.msg:36704 game/combatai.msg:36704
msgid "You pay for this -- later!"
msgstr "La pagherai per questo -- a dopo!"

#: game/cmbatai2.msg:36705 game/combatai.msg:36705
msgid "We are Chosen! You die later!"
msgstr "Noi siamo i Prescelti! Morirai... piu' tardi!"

#: game/cmbatai2.msg:36720 game/combatai.msg:36720
msgid "Your death comes!"
msgstr "Arriva la morte!"

#: game/cmbatai2.msg:36721 game/combatai.msg:36721
msgid "Those who bother Chosen, bother no one again!"
msgstr "Chi disturba un Prescelto, non disturba piu' nessun altro!"

#: game/cmbatai2.msg:36722 game/combatai.msg:36722
msgid "Human weapons cannot harm me!"
msgstr "Le armi umane non possono feririmi!"

#: game/cmbatai2.msg:36723 game/cmbatai2.msg:36727 game/combatai.msg:36723
#: game/combatai.msg:36727
msgid "You will suffer, suffer great!"
msgstr "Soffrirai, soffrirai molto!"

#: game/cmbatai2.msg:36724 game/combatai.msg:36724
msgid "When I fight, I kill!"
msgstr "Quando combatto, uccido!"

#: game/cmbatai2.msg:36725 game/combatai.msg:36725
msgid "Who is stupid enough to anger us?"
msgstr "Chi e' cosi' stupido da attaccarci?"

#: game/cmbatai2.msg:36726 game/combatai.msg:36726
msgid "I see enemies to destroy!"
msgstr "Vedo nemici da distruggere!"

#: game/cmbatai2.msg:36740
msgid "Now you die"
msgstr "Adesso morirai"

#: game/cmbatai2.msg:36741 game/combatai.msg:36741
msgid "Nobody save you now!"
msgstr "Nessuno puo' salvarti, adesso!"

#: game/cmbatai2.msg:36742 game/combatai.msg:36742
msgid "Let me see your pain!"
msgstr "Lascia che ti faccia vedere il dolore!"

#: game/cmbatai2.msg:36743 game/combatai.msg:36743
msgid "Now you die burning death!"
msgstr "Morirai di una morte atroce!"

#: game/cmbatai2.msg:36744 game/combatai.msg:36744
msgid "Die Human Fool!"
msgstr "Muori Folle Umano!"

#: game/cmbatai2.msg:36745
msgid "Now you die a screaming death"
msgstr "Morirai di una morte terribile!"

#: game/cmbatai2.msg:36746 game/combatai.msg:36746
msgid "Suffer!"
msgstr "Soffri!"

#: game/cmbatai2.msg:36747 game/combatai.msg:36747
msgid "Now I crush you!"
msgstr "Adesso ti schiaccio!"

#: game/cmbatai2.msg:36748 game/combatai.msg:36748
msgid "You cannot fight the Chosen!"
msgstr "Non puoi sconfiggere i Prescelti!"

#: game/cmbatai2.msg:36749 game/combatai.msg:36749
msgid "Suffer, human!"
msgstr "Soffri, umano!"

#: game/cmbatai2.msg:36760 game/combatai.msg:36760
msgid "Why do you struggle?"
msgstr "Perche' ti sforzi?"

#: game/cmbatai2.msg:36761 game/combatai.msg:36761
msgid "Is that best humans can do!"
msgstr "Questo e' il meglio che gli umani possono fare!"

#: game/cmbatai2.msg:36762 game/combatai.msg:36762
msgid "You have no power!"
msgstr "Non hai potere!"

#: game/cmbatai2.msg:36763 game/combatai.msg:36763
msgid "You make me laugh hard!"
msgstr "Mi fai sbudellare dalle risate!"

#: game/cmbatai2.msg:36764 game/combatai.msg:36764
msgid "Was that an attack?"
msgstr "Era un attacco, questo?"

#: game/cmbatai2.msg:36765 game/combatai.msg:36765
msgid "We are the Chosen!"
msgstr "Noi siamo i Prescelti!"

#: game/cmbatai2.msg:44800 game/combatai.msg:44800
msgid "I'm thick skulled but that still hurt."
msgstr "Ho la testa dura, ma questo mi ha fatto male."

#: game/cmbatai2.msg:44801 game/combatai.msg:44801
msgid "I've got one hell of a headache."
msgstr "Ho un enorme mal di testa."

#: game/cmbatai2.msg:44802 game/combatai.msg:44802
msgid "Umph. Not the head!"
msgstr "Umph. Non la testa!"

#: game/cmbatai2.msg:44803 game/combatai.msg:44803
msgid "I can do head shots too you know!"
msgstr "Anch'io posso colpire la testa, sai?!"

#: game/cmbatai2.msg:44804 game/combatai.msg:44804
msgid "Arrrgh! Dizzy..."
msgstr "Arrrgh! Stordimento..."

#: game/cmbatai2.msg:44810 game/combatai.msg:44810
msgid "I'll kill you with my other arm."
msgstr "Ti ammazzero' con l'altro braccio."

#: game/cmbatai2.msg:44811 game/combatai.msg:44811
msgid "I don't need both arms to ruin your day!"
msgstr "Non mi servono entrambe le braccia per rovinarti la giornata!"

#: game/cmbatai2.msg:44812 game/combatai.msg:44812
msgid "I don't use that arm anyway."
msgstr "Tanto non lo usavo, quel braccio."

#: game/cmbatai2.msg:44813 game/combatai.msg:44813
msgid "Ouch! I can use a sling over here."
msgstr "Ouch! Mi servirebbe qualcosa per sostenere il braccio."

#: game/cmbatai2.msg:44814 game/combatai.msg:44814
msgid "One arm down, one to go!"
msgstr "Un braccio e' andato, ne resta uno solo!"

#: game/cmbatai2.msg:44820 game/combatai.msg:44820
msgid "Hey, that's my fighting arm!"
msgstr "Ehi, questo e' il braccio con cui combatto!"

#: game/cmbatai2.msg:44821 game/combatai.msg:44821
msgid "Damn that arm hurts!"
msgstr "Cavolo, il braccio fa male!"

#: game/cmbatai2.msg:44822 game/combatai.msg:44822
msgid "I can take the likes of you with only one arm."
msgstr "Posso battere i tipi come te anche con un braccio solo."

#: game/cmbatai2.msg:44823 game/combatai.msg:44823
msgid "Right arm... arrgh!"
msgstr "Il braccio destro... arrgh!"

#: game/cmbatai2.msg:44824 game/combatai.msg:44824
msgid "You hit my arm. I tear off your arm!"
msgstr "Tu mi hai colpito il braccio. Io strappero' il tuo!"

#: game/cmbatai2.msg:44830 game/combatai.msg:44830
msgid "Umph... can't... breathe."
msgstr "Umph... non posso... respirare."

#: game/cmbatai2.msg:44831 game/combatai.msg:44831
msgid "I'm minus a couple of ribs after that one."
msgstr "Dopo quel colpo mi mancano due costole."

#: game/cmbatai2.msg:44832 game/combatai.msg:44832
msgid "Ouch! I hate gut shots."
msgstr "Ouch! Odio questi colpi."

#: game/cmbatai2.msg:44833 game/combatai.msg:44833
msgid "Arrgghh! Chest pains!"
msgstr "Arrgghh! Il petto mi fa male!"

#: game/cmbatai2.msg:44834 game/combatai.msg:44834
msgid "Solar plexus... eegad that hurts!"
msgstr "Il plesso solare... cavoli se fa male!"

#: game/cmbatai2.msg:44835 game/combatai.msg:44835
msgid "Is this a fight or are you just trying to get my attention?"
msgstr ""
"Questo e' un combattimento, oppure stai solo cercando di attirare la mia "
"attenzione?"

#: game/cmbatai2.msg:44836 game/combatai.msg:44836
msgid "Let me know if that was supposed to hurt. I'll cry for you."
msgstr ""
"Fammi sapere se questo colpo avrebbe dovuto farmi male. Piangero' per te."

#: game/cmbatai2.msg:44837 game/combatai.msg:44837
msgid "Did your mama teach you how to fight?"
msgstr "E' stata la tua mammina ad insegnarti a combattere?"

#: game/cmbatai2.msg:44838
msgid "Oh the pain (yawn). Please don't hurt me any more."
msgstr "Oh, che dolore (yawn). Ti prego, non colpirmi ancora."

#: game/cmbatai2.msg:44839 game/combatai.msg:44839
msgid "You call that a hit. Let me show you how it's done!"
msgstr "E questo lo chiami un colpo? Lascia che ti mostri come si fa!"

#: game/cmbatai2.msg:44840 game/combatai.msg:44840
msgid "I'm going to kick your ass for that one."
msgstr "Ti spacchero' il culo per questo."

#: game/cmbatai2.msg:44841 game/combatai.msg:44841
msgid "Whoa! That stings a bit."
msgstr "Whoa! Questo punge un po'."

#: game/cmbatai2.msg:44842 game/combatai.msg:44842
msgid "I left the vault for this!?"
msgstr "Ho lasciato il vault per questo!?"

#: game/cmbatai2.msg:44843 game/combatai.msg:44843
msgid "I'm going to need a vacation."
msgstr "Credo che avro' bisogno di una vacanza."

#: game/cmbatai2.msg:44844 game/combatai.msg:44844
msgid "Yeeeouch! That hurts!"
msgstr "Yeeeouch! Che male!"

#: game/cmbatai2.msg:44845
msgid "That didn't hurt at all"
msgstr "Non mi hai fatto male"

#: game/cmbatai2.msg:44846 game/combatai.msg:44846
msgid "Where's a stimpak when you need one?"
msgstr "Dove sono gli stimpak quando hai bisogno di loro?"

#: game/cmbatai2.msg:44847
msgid "As soon as I can move again, you've had it"
msgstr "Appena saro' in grado di muovermi nuovamente, la vedrai"

#: game/cmbatai2.msg:44848 game/combatai.msg:44848
msgid "I am impervious to pain!"
msgstr "Sono insensibile al dolore!"

#: game/cmbatai2.msg:44849 game/combatai.msg:44849
msgid "I'm going to do the monster mash on your face!"
msgstr "Ti ridurro' la faccia in un pure'!"

#: game/cmbatai2.msg:44860 game/combatai.msg:44860
msgid "Great. I'll be the only deathclaw at home with a limp."
msgstr "Grande. Saro' l'unico deathclaw del clan a zoppicare."

#: game/cmbatai2.msg:44861 game/combatai.msg:44861
msgid "Ouch! My leg..."
msgstr "Ouch! La gamba..."

#: game/cmbatai2.msg:44862 game/combatai.msg:44862
msgid "You'll pay with your leg for what you did to mine."
msgstr "Pagherai quello che hai fatto alla mia gamba... con la tua."

#: game/cmbatai2.msg:44863 game/combatai.msg:44863
msgid "I'll miss that leg..."
msgstr "Mi manchera', questa gamba..."

#: game/cmbatai2.msg:44864 game/combatai.msg:44864
msgid "I don't need two legs to kill you."
msgstr "Non mi servono due gambe, per ucciderti."

#: game/cmbatai2.msg:44870 game/combatai.msg:44870
msgid "Great. A bum leg."
msgstr "Grande. Una gamba fottuta."

#: game/cmbatai2.msg:44871 game/combatai.msg:44871
msgid "Damn it! The leg..."
msgstr "Dannazione! La gamba..."

#: game/cmbatai2.msg:44872 game/combatai.msg:44872
msgid "Not the leg... can't walk right as it is."
msgstr "Non la gamba... gia' non camminavo bene."

#: game/cmbatai2.msg:44873 game/combatai.msg:44873
msgid "You cripple my leg, I cripple your leg."
msgstr "Tu mi hai spaccato la gamba, io spappolero' la tua."

#: game/cmbatai2.msg:44874 game/combatai.msg:44874
msgid "Arrggh! That knee hurts!"
msgstr "Arrggh! Che male al ginocchio!"

#: game/cmbatai2.msg:44880 game/combatai.msg:44880
msgid "Can't see!"
msgstr "Non ci vedo!"

#: game/cmbatai2.msg:44881 game/combatai.msg:44881
msgid "Not the eyes!"
msgstr "Non gli occhi!"

#: game/cmbatai2.msg:44882 game/combatai.msg:44882
msgid "Blood... in eyes... can't see."
msgstr "Sangue... negli occhi... non ci vedo."

#: game/cmbatai2.msg:44883 game/combatai.msg:44883
msgid "I can't see you, but I can smell you."
msgstr "Non posso vederti, ma posso sentire il tuo odore."

#: game/cmbatai2.msg:44884 game/combatai.msg:44884
msgid "I'm going to need glasses after that one!"
msgstr "Mi serviranno degli occhiali dopo questo colpo!"

#: game/cmbatai2.msg:44890 game/combatai.msg:44890
msgid "The groin is such a cheap shot!"
msgstr "Colpirmi all'inguine... che colpo meschino!"

#: game/cmbatai2.msg:44891 game/combatai.msg:44891
msgid "No... hitting... below... the belt!"
msgstr "Non... si colpisce... sotto... la cintola!"

#: game/cmbatai2.msg:44892 game/combatai.msg:44892
msgid "That's fighting dirty. How about if I hit you in the crotch?"
msgstr ""
"Questo vuol dire combattere sporco. Cosa ne diresti se ti colpissi io al "
"cavallo?"

#: game/cmbatai2.msg:44893 game/combatai.msg:44893
msgid "I HATE groin shots! Unngh..."
msgstr "ODIO i colpi all'inguine! Unngh..."

#: game/cmbatai2.msg:44894 game/combatai.msg:44894
msgid "Crotch shot... good thing I'm not human!"
msgstr "Colpo al cavallo... Per fortuna non sono un umano!"

#: game/cmbatai2.msg:44900 game/combatai.msg:44900
msgid "Time to bail!"
msgstr "E' ora di filarsela!"

#: game/cmbatai2.msg:44901 game/combatai.msg:44901
msgid "I'm leaving!"
msgstr "Me ne vado!"

#: game/cmbatai2.msg:44906 game/combatai.msg:44906
msgid "Out of the way, I'm moving out!"
msgstr "Fuori dai piedi, me ne sto andando!"

#: game/cmbatai2.msg:44907 game/combatai.msg:44907
msgid "I'm not retreating, this is a strategic withdrawal."
msgstr "Non sto scappando, questa e' una ritirata strategica."

#: game/cmbatai2.msg:44908 game/combatai.msg:44908
msgid "I've had enough of this shit!"
msgstr "Ne ho abbastanza di queste stronzate!"

#: game/cmbatai2.msg:44909 game/combatai.msg:44909
msgid "I've got to get out of here!"
msgstr "Devo andarmene da qui!"

#: game/cmbatai2.msg:44920 game/combatai.msg:44920
msgid "Come here so I can hit you!"
msgstr "Vieni qui, che' voglio colpirti!"

#: game/cmbatai2.msg:44921 game/combatai.msg:44921
msgid "You're all mine!"
msgstr "Sei tutto mio!"

#: game/cmbatai2.msg:44922 game/combatai.msg:44922
msgid "It's you or me... and I vote you!"
msgstr "Uno dei due morira'... e io voto per te!"

#: game/cmbatai2.msg:44923 game/combatai.msg:44923
msgid "It's your funeral!"
msgstr "E' il tuo funerale!"

#: game/cmbatai2.msg:44924 game/combatai.msg:44924
msgid "Come and get it!"
msgstr "Vieni!"

#: game/cmbatai2.msg:44925 game/combatai.msg:44925
msgid "Prepare to meet your doom!"
msgstr "Preparati ad incontrare il tuo destino!"

#: game/cmbatai2.msg:44926 game/combatai.msg:44926
msgid "Best kiss your ass goodbye while you still can."
msgstr "Faresti meglio a dire le preghiere finche' sei ancora in tempo."

#: game/cmbatai2.msg:44927 game/combatai.msg:44927
msgid "I'm going to paint you red!"
msgstr "Ti dipingero' di rosso!"

#: game/cmbatai2.msg:44929 game/combatai.msg:44929
msgid "I'm heading in!"
msgstr "Sto arrivando!"

#: game/cmbatai2.msg:44930 game/combatai.msg:44930
msgid "I'll see you on the front line!"
msgstr "Ci vediamo al fronte!"

#: game/cmbatai2.msg:44931 game/combatai.msg:44931
msgid "Time to reach out and touch someone!"
msgstr "E' ora di raggiungere e colpire qualcuno!"

#: game/cmbatai2.msg:44932 game/combatai.msg:44932
msgid "Advance and annihilate!"
msgstr "Avanzata ed Eliminazione!"

#: game/cmbatai2.msg:44933 game/combatai.msg:44933
msgid "I'm going to fall on you like ugly on a human!"
msgstr "Arrivero' su di te come un falco sulla sua preda!"

#: game/cmbatai2.msg:44934 game/combatai.msg:44934
msgid "Time to get physical!"
msgstr "E' ora di fare un po' di esercizio fisico!"

#: game/cmbatai2.msg:44935 game/combatai.msg:44935
msgid "Getting up close and personal."
msgstr "La cosa si sta facendo personale."

#: game/cmbatai2.msg:44936 game/combatai.msg:44936
msgid "Bad ass moving in!"
msgstr "Lupo cattivo in arrivo!"

#: game/cmbatai2.msg:44937 game/combatai.msg:44937
msgid "Incoming!"
msgstr "Sto arrivando!"

#: game/cmbatai2.msg:44938 game/combatai.msg:44938
msgid "Locked on target and homing!"
msgstr "Bersaglio acquisito e in avvicinamento!"

#: game/cmbatai2.msg:44939 game/combatai.msg:44939
msgid "There's a storm coming!"
msgstr "Arriva la bufera!"

#: game/cmbatai2.msg:44940 game/combatai.msg:44940
msgid "I'm going to hurt you... bad!"
msgstr "Sto per farti *davvero* male!"

#: game/cmbatai2.msg:44941 game/combatai.msg:44941
msgid "This is going to hurt you a lot more than it does me!"
msgstr "Questo fara' molto piu' male a te che a me!"

#: game/cmbatai2.msg:44942 game/combatai.msg:44942
msgid "Do unto others before they do unto you!"
msgstr "Fallo agli altri prima che gli altri lo facciano a te!"

#: game/cmbatai2.msg:44943 game/combatai.msg:44943
msgid "If there's a part of you that doesn't hurt, it's next!"
msgstr ""
"Se hai qualche parte del corpo che non ti fa male, sappi che lo fara' presto!"

#: game/cmbatai2.msg:44944 game/combatai.msg:44944
msgid "Contact sports. I love it!"
msgstr "Sport di contatto. Lo adoro!"

#: game/cmbatai2.msg:44945 game/combatai.msg:44945
msgid "Tell me your name so I can contact your next of kin."
msgstr "Dimmi il tuo nome cosi' potro' contattare i tuoi parenti."

#: game/cmbatai2.msg:44946 game/combatai.msg:44946
msgid "I'm the one who put the 'death' in deathclaw!"
msgstr "Se desideri, puoi chiamarmi \"Morte\"!"

#: game/cmbatai2.msg:44947 game/combatai.msg:44947
msgid "It's better to give than to receive!"
msgstr "Meglio dare che ricevere!"

#: game/cmbatai2.msg:44948 game/combatai.msg:44948
msgid "I hope you're enjoying this as much as I am!"
msgstr "Spero che tu ti stia divertendo quanto mi sto divertendo io!"

#: game/cmbatai2.msg:44949 game/combatai.msg:44949
msgid "Did that hurt? If not I can do it harder next time."
msgstr ""
"Ti ha fatto male? Altrimenti posso colpire piu' forte, la prossima volta."

#: game/cmbatai2.msg:44950 game/combatai.msg:44950
msgid "We have a bleeder over here!"
msgstr "Abbiamo un'emorragia qui!"

#: game/cmbatai2.msg:44951 game/combatai.msg:44951
msgid "It'll take more than a stimpak to fix you when I'm done."
msgstr ""
"Ti servira' piu' di uno stimpak per rimetterti in sesto dopo che avro' "
"finito con te."

#: game/cmbatai2.msg:44952 game/combatai.msg:44952
msgid "I hope you have medical insurance. You're going to need it."
msgstr "Spero tu sia assicurato contro gli infortuni. Ne avrai bisogno."

#: game/cmbatai2.msg:44953 game/combatai.msg:44953
msgid "Here a rip, there a rip, everywhere a rip rip..."
msgstr "Ecco un taglio, un'altro taglio, tagli dappertutto..."

#: game/cmbatai2.msg:44954 game/combatai.msg:44954
msgid "I don't care who started it, I intend to finish it!"
msgstr "Non mi interessa chi ha cominciato, so solo che voglio finita io!"

#: game/cmbatai2.msg:44955 game/combatai.msg:44955
msgid "I love the sound of tearing flesh, don't you?"
msgstr "Adoro il suono della carne macinata, e tu?"

#: game/cmbatai2.msg:44956 game/combatai.msg:44956
msgid "Just warming up, the best is yet to come."
msgstr "Mi sto solo scaldando, il meglio deve ancora venire."

#: game/cmbatai2.msg:44957 game/combatai.msg:44957
msgid "Just sharpening my claws."
msgstr "Sto ancora affilando i miei artigli."

#: game/cmbatai2.msg:44958 game/combatai.msg:44958
msgid "Ooops! Hope you didn't need that!"
msgstr "Ooops! Spero che tu non abbia ancora bisogno di quello!"

#: game/cmbatai2.msg:44959 game/combatai.msg:44959
msgid "If you fall over and stay there I'll go away!"
msgstr "Se ti butti a terra e stai immobile, io me ne andro'!"

#: game/cmbatai2.msg:44960
msgid "Will you stop moving around so I can hit you?"
msgstr "La smetti di muoverti? Altrimenti non posso colpirti!"

#: game/cmbatai2.msg:44961
msgid "Glasses. Must look into getting some glasses."
msgstr "Occhiali. Devo decidermi a prendere degli occhiali."

#: game/cmbatai2.msg:44962
msgid "Don't laugh. When I do hit you, it's going to hurt!"
msgstr "Non ridere. Quando ti colpiro', ti fara' male!"

#: game/cmbatai2.msg:44963
msgid "Arrg! Grng! Ghrr! Thpt! (Deathclaw four-letter words)"
msgstr "Arrg! Grng! Ghrr! Thpt! (Parole da 4 lettere in lingua Deathclaw)"

#: game/cmbatai2.msg:44964
msgid "I guess I shouldn't make a career out of fighting."
msgstr "Immagino che non riuscirei a guadagnarmi il pane, lottando."

#: game/cmbatai2.msg:44965
msgid "How could I possibly miss anything as big as you are!"
msgstr "Come posso aver mancato una cosa grossa come te!"

#: game/cmbatai2.msg:44966
msgid "As soon as I get ranged in you're in trouble."
msgstr "Non appena mi saro' avvicinato un attimo, sarai nei guai."

#: game/cmbatai2.msg:44967
msgid "You're a nimble little shit aren't you."
msgstr "Sei davvero agile, piccolo stronzo..."

#: game/cmbatai2.msg:44968
msgid "I'm glad my mother didn't see me do that."
msgstr "Sono felice che mia madre non abbia visto quello che ho fatto."

#: game/cmbatai2.msg:44969
msgid "Why am I swinging over there when you're over here?"
msgstr "Perche' colpisco in quella direzione se tu ti trovi dall'altra?"

#: game/cmbatai2.msg:44970
msgid "How embarrassing. Please don't tell anyone I did that."
msgstr "Com'e' imbarazzante. Per favore, non dirlo a nessuno."

#: game/cmbatai2.msg:44971
msgid "That really pisses me off!"
msgstr "Queste cose mi fanno davvero incavolare!"

#: game/cmbatai2.msg:44972
msgid "Ok. I missed! It could happen to anyone!"
msgstr "Ok. Ti ho mancato! Puo' succedere a tutti!"

#: game/cmbatai2.msg:44973
msgid "I'll get you next time."
msgstr "Ti becchero' la prossima volta."

#: game/cmbatai2.msg:44974
msgid "Way to go, Grace!"
msgstr "Cosi' si fa, Grace!"

#: game/cmbatai2.msg:44975
msgid "That was a shining example of missing the target!"
msgstr "Questo e' uno splendido esempio di come si mancano i bersagli!"

#: game/cmbatai2.msg:44976
msgid "I'm beginning to think I'm not cut out for this."
msgstr "Inizio a pensare di non esserci tagliato."

#: game/cmbatai2.msg:44977
msgid "Arrggh! I can't believe I missed you!"
msgstr "Arrggh! Non posso credere di averti mancato!"

#: game/cmbatai2.msg:44978
msgid "I fanned the air on that one I did!"
msgstr "Ho fatto un po' di vento all'aria!"

#: game/cmbatai2.msg:44979
msgid "Did I just miss you or what!"
msgstr "Ti ho appena mancato o cosa?"

#: game/combat.msg:100
msgid "You need %d action points."
msgstr "Ti servono %d punti azione."

#: game/combat.msg:101
msgid "Out of ammo."
msgstr "Finite le munizioni."

#: game/combat.msg:102
msgid "Target out of range."
msgstr "Bersaglio fuori portata."

#: game/combat.msg:103
msgid "Combat cannot end with nearby hostile creatures."
msgstr "Il combattimento non puo' finire con creature ostili nei paraggi."

#: game/combat.msg:104
msgid "Your aim is blocked."
msgstr "La tua mira e' bloccata."

#: game/combat.msg:105
msgid "You cannot use weapons with both arms crippled."
msgstr "Non puoi usare armi con entrambe le braccia ferite."

#: game/combat.msg:106
msgid "You cannot use two-handed weapons with a crippled arm."
msgstr "Non puoi usare armi a due mani con un braccio ferito."

#: game/combat.msg:107
msgid "You are not strong enough to use this weapon properly."
msgstr "Non sei abbastanza forte da poter usare bene quest'arma."


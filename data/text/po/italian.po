#: game/pro_wall.msg:188600
msgid "Glowing Cave Wall"
msgstr "Parete della grotta luminescente"

#: game/pro_scen.msg:223100 game/pro_scen.msg:223200 game/pro_scen.msg:223300
#: game/pro_scen.msg:223400 game/pro_scen.msg:223500 game/pro_scen.msg:223600

#: game/cmbatai2.msg:32546 game/combatai.msg:32546
msgid "I got a present for you."
msgstr "Ho un regalino per te."

#: game/cmbatai2.msg:32547 game/combatai.msg:32547
msgid "You want a piece of me?"
msgstr "Ne vuoi ancora?"

#: game/cmbatai2.msg:32548 game/combatai.msg:32548
msgid "He shoots... he scores!"
msgstr "Spara... e colpisce!"

#: game/cmbatai2.msg:32549 game/combatai.msg:32549
msgid "How about some lovin'?"
msgstr "Che ne dici di un po' di amore?"

#: game/cmbatai2.msg:32560 game/combatai.msg:32560
msgid "That's right!"
msgstr "Dai cosi'!"

#: game/cmbatai2.msg:32561 game/combatai.msg:32561
msgid "That's RIGHT!"
msgstr "Dai COSI'!"

#: game/cmbatai2.msg:32562 game/combatai.msg:32562
msgid "Ha ha ha!"
msgstr "Ah ah ah!"

#: game/cmbatai2.msg:32563 game/combatai.msg:32563
msgid "Do you ever get any better?"
msgstr "Non sai fare di meglio?"

#: game/cmbatai2.msg:32564 game/combatai.msg:32564
msgid "Can't touch this!"
msgstr "Non puoi toccarlo!"

#: game/cmbatai2.msg:32565 game/combatai.msg:32565
msgid "Ow! Ha ha... just kidding."

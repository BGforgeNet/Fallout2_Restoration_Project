#: dialog/ncnikki.msg:272
msgid "Hey, sweetie...(smiles)...wanna take a chance?"
msgstr "Ehi, dolcezza… [sorride]… vuoi tentare la fortuna?"

#: dialog/ncnikki.msg:276 dialog/zidcegrl.msg:295
msgid "Step right up, win some chips."
msgstr "Avanti, avanti… venite a vincere qualche gettone."

#: dialog/ncnikki.msg:277 dialog/zidcegrl.msg:296
msgid "Need another drink, honey?"
msgstr "Vuoi bere qualcosa, tesoro?"

#: dialog/ncnikki.msg:278 dialog/ncnikki.msg:282 dialog/zidcegrl.msg:297
#: dialog/zidcegrl.msg:301

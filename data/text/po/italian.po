msgid "Bring a bottle of Abbey's hootch to Father Tully."
msgstr "Porta una bottiglia del liquore dell'Abbazia a Padre Tully."

#: game/quests.msg:1100
msgid "Retrieve Parts/Gain Access to Vault 15."
msgstr "Recupera i componenti/Ottieni l'accesso al Vault 15."

#: game/quests.msg:1101
msgid "\"Take care of\" Officer Jack for Mira."
msgstr "\"Prenditi cura\" di Jack il poliziotto per Mira."


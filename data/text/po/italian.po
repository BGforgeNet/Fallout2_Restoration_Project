msgctxt "female"
msgid "You next."
msgstr "Tu essere prossima!"

#~ msgid "You see a safe set securely into the wall. It is closed."
#~ msgstr "Vedi una cassaforte incassata saldamente nel muro. E' chiusa."

#~ msgid "You see a safe set securely into the wall. It is open."
#~ msgstr "Vedi una cassaforte incassata saldamente nel muro. E' aperta."

#~ msgid ""
#~ "(There is a little door in the wall. A very, very small person must live "
#~ "inside! There is a doorknob with numbers on it in the middle of the door.)"
#~ msgstr ""
#~ "(C'e' una piccola porta nel muro. Dev'essere la casa di una persona davvero "
#~ "molto, molto piccola! Al centro della porta c'e' una maniglia con dei numeri "
#~ "sopra.)"

#~ msgid "(There is a KER-KLANK, and the safe opens.)"
#~ msgstr "(Si sente un KER-KLANK, e la cassaforte si apre.)"

#~ msgid ""
#~ "(You turn the dial slowly for several minutes, but you can't make out "
#~ "anything.)"
#~ msgstr ""
#~ "(Giri lentamente la manopola per svariati minuti, ma non riesci ad ottenere "
#~ "alcunche'.)"

#~ msgid "(You don't find any traps on the safe.)"
#~ msgstr "(Non trovi trappole collegate alla cassaforte.)"

#~ msgid ""
#~ "(You are turning the knob... when suddenly there is a KER-KLANK, and the "
#~ "door opens!)"
#~ msgstr ""
#~ "(Stai girando la maniglia... quando improvvisamente si sente un KER-KLANK, e "
#~ "la porta si apre!)"

#~ msgid "(You turn the knob, but the tiny door won't open!)"
#~ msgstr "(Giri la maniglia, ma la porticina non si apre!)"

#~ msgid ""
#~ "(You don't hear anybody, and you can't see a doorbell. Maybe nobody's home.)"
#~ msgstr ""
#~ "(Non senti nessuno e non riesci a vedere il campanello. Forse in casa non "
#~ "c'e' nessuno.)"

#~ msgid ""
#~ "(Close inspection reveals a small cube of plastic explosive set into the "
#~ "wall just beneath the safe, primed to go off if the user enters the wrong "
#~ "combination. It was covered with a thin layer of plaster to disguise it.)"
#~ msgstr ""
#~ "(Un'attenta ispezione rivela un piccolo cubo di esplosivo al plastico "
#~ "piazzato nel muro sotto la cassaforte, regolato per esplodere nel caso in "
#~ "cui qualcuno inserisca la combinazione sbagliata. Era coperto da un sottile "
#~ "strato di gesso che lo nascondeva.)"

#~ msgid ""
#~ "(With surgical precision, you disarm the fuse and pull the plastic explosive "
#~ "from the wall. The trap is now disarmed.)"
#~ msgstr ""
#~ "(Con precisione chirurgica, disarmi la spoletta e togli l'esplosivo al "
#~ "plastico dal muro. La trappola adesso e' disattivata.)"

#~ msgid ""
#~ "(With surgical precision, you open the primer and adjust the tumbler "
#~ "combination trigger. The owner of this safe will be\n"
#~ " in for a surprise when he tries to open it again.)"
#~ msgstr ""
#~ "(Con precisione chirurgica, apri l'innesco e regoli il detonatore collegato "
#~ "alla manopola della combinazione. Il proprietario di questa cassaforte avra' "
#~ "una bella sorpresa quando cerchera' di aprirla di nuovo.)"

#, fuzzy
#~ msgid ""
#~ "(You pry up a small panel on the bottom of the safe. You don't think you "
#~ "would have found it if Mrs. Bishop hadn't told you about it. Inside is an "

msgid "Wanna come over to my place for a drink?"
msgstr "Vuoi fare un salto a casa mia per un drink?"

#: dialog/nccaspat.msg:274 dialog/ncperson.msg:246
msgid "I want to eat my dinner off your chest."
msgstr "Voglio mangiare la mia cena sul tuo petto."

#: dialog/nccaspat.msg:275 dialog/ncperson.msg:247
msgid "Need a partner for your next film?"
msgstr "Ti serve una partner per il tuo prossimo film?"

#: dialog/nccaspat.msg:276 dialog/ncperson.msg:248
msgid "::Stares at your biceps.::"
msgstr "::Osserva i tuoi bicipiti.::"

#: dialog/nccaspat.msg:277 dialog/ncjules.msg:380 dialog/ncperson.msg:365
#: dialog/ncprosti.msg:462

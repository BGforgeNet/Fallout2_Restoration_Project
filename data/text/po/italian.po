#: game/cmbatai2.msg:33295 game/combatai.msg:33295
msgid "I think I'll go into shock now."
msgstr "E' stato un vero shock per me."

#: game/cmbatai2.msg:36000 game/combatai.msg:36000
msgid "Gawd! That hit me in the head!"
msgstr "Dio! Mi ha preso la testa!"

#: game/cmbatai2.msg:36001 game/combatai.msg:36001
msgid "Ow! My head!"
msgstr "Ow! La testa!"

#: game/cmbatai2.msg:36002 game/combatai.msg:36002
msgid "Oof! Kaga's head is on fire!"
msgstr "Oof! La testa di Kaga va in fiamme!"

#: game/cmbatai2.msg:36010 game/combatai.msg:36010
msgid "My hand!"
msgstr "La mano!"

#: game/cmbatai2.msg:36011
msgid "Ow! Good thing I'm right handed"
msgstr "Ow! Per fortuna scrivo con la destra"

#: game/cmbatai2.msg:36012 game/combatai.msg:36012
msgid "Ow!!"
msgstr "Ow!!"

#: game/cmbatai2.msg:36020
msgid "Ow, my arm"
msgstr "Ow, il braccio"

#: game/cmbatai2.msg:36030 game/combatai.msg:36030
msgid "(Grunt!)"
msgstr "(Grugnisce!)"

#: game/cmbatai2.msg:36031 game/combatai.msg:36031

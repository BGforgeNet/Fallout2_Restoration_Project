#: game/pro_scen.msg:215900 game/pro_scen.msg:216100 game/pro_scen.msg:216200
#: game/pro_scen.msg:216300 game/pro_scen.msg:216400
msgid "Rusty Machinery"
msgstr "Macchinario arrugginito"

#: game/pro_scen.msg:217300
msgid "Submarine Hatch"
msgstr "Portello del sottomarino"

#: game/pro_scen.msg:217600
msgid "Poseidon Oil Sign"
msgstr "Insegna Poseidon Oil"

#: game/pro_scen.msg:217601
msgid "This old neon sign still has some life left in it."
msgstr "Questa vecchia insegna al neon funziona ancora un po'."

#: game/pro_scen.msg:217700
msgid "Massive Steel Vault Doors"
msgstr "Massive porte d’acciaio del Vault"

#: game/pro_scen.msg:217701
msgid "These steel doors are practically indestructible."
msgstr "Queste porte d’acciaio sono praticamente indistruttibili."

#: game/pro_scen.msg:218800 game/pro_scen.msg:218900
msgid "Sub Tower"
msgstr "Torre di servizio"

#: game/pro_scen.msg:219001 game/pro_scen.msg:219101 game/pro_scen.msg:219201
msgid "A set of wooden stairs."
msgstr "Delle scale di legno."

#: game/pro_scen.msg:219801
msgid "A sketched portrait of a fugitive wanted by the local authorities."
msgstr ""
"Un ritratto abbozzato di un fuggitivo ricercato dalle autorita' locali."

#: game/pro_scen.msg:220100
msgid "Rusty Steel Rail"
msgstr "Ringhiera d'acciaio arrugginita"

#: game/pro_scen.msg:220400 game/pro_scen.msg:220500 game/pro_scen.msg:220600
#: game/pro_scen.msg:220700 game/pro_scen.msg:220800
msgid "Glowing Bones"
msgstr "Ossa luminescenti"

#: game/pro_scen.msg:220401 game/pro_scen.msg:220501
msgid ""
"A large pile of glowing animal bones. At least, you think all the bones are "
"animal..."
msgstr ""
"Un grosso mucchio di ossa animali luminescenti. O almeno, *credi* che siano "
"tutte animali..."

#: game/pro_scen.msg:220601
msgid ""
"A very large pile of glowing bones. You cannot determine the species of the "
"dead critters."
msgstr ""
"Un enorme mucchio di ossa luminescenti. Non riesci a determinare la specie "
"delle creature morte."

#: game/pro_scen.msg:220701
msgid ""
"You think these might be Horned Kangaroo bones, but you cannot be sure. They "
"are glowing and too weathered to make a final determination."
msgstr ""
"Potrebbero essere ossa di Canguro Cornuto, ma non ne sei certo. Sono "
"luminescenti e troppo consumate per esserne sicuro."

#: game/pro_scen.msg:220801
msgid "You see the bones of a large, glowing two-headed cow."
msgstr "Vedi le ossa di una grande mucca bicipite luminescente."

#: game/pro_scen.msg:220901
msgid ""
"A large amount of glowing rocks, far more than could ever be moved easily."
msgstr ""
"Un grande mucchio di rocce luminescenti, molte piu' di quante si possano "
"spostare facilmente."

#: game/pro_scen.msg:221000
msgid "Glowing Metal Cover"
msgstr "Coperchio metallico luminescente"

#: game/pro_scen.msg:221001
msgid ""
"A heavy glowing man-hole cover. It looks like it is in good shape, and that "
"it was recently moved."
msgstr ""
"Un pesante coperchio di tombino luminescente. Sembra in buone condizioni ed "
"e' stato spostato di recente."

#: game/pro_scen.msg:221100
msgid "Glowing Sewer Hole"
msgstr "Tombino luminescente"

#: game/pro_scen.msg:221101
msgid "It looks like an access hole for the sewer system. It's glowing green!"
msgstr "Sembra un accesso al sistema fognario. E' verde e luminescente!"

#: game/pro_scen.msg:221200 game/pro_scen.msg:221300
msgid "Glowing Stalagmite"
msgstr "Stalagmite luminescente"

#: game/pro_scen.msg:221201 game/pro_scen.msg:221301
msgid "A natural extension of the rock floor. This one's glowing green!"
msgstr ""
"Un'estensione naturale del pavimento roccioso. Questa e' verde e "
"luminescente!"

#: game/pro_scen.msg:221400 game/pro_scen.msg:221500
msgid "Glowing Rock Column"
msgstr "Colonna di roccia luminescente"

#: game/pro_scen.msg:221401
msgid "This thick column of rock extends from floor to ceiling. It's glowing!"
msgstr ""
"Questa spessa colonna di roccia si estende dal pavimento al soffitto. E' "
"luminescente!"

#: game/pro_scen.msg:221501
msgid "This thin column of rock extends from floor to ceiling. It's glowing!"
msgstr ""
"Questa sottile colonna di roccia si estende dal pavimento al soffitto. E' "
"luminescente!"

#: game/pro_scen.msg:221600 game/pro_scen.msg:221700 game/pro_scen.msg:221800

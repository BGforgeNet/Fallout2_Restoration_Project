#: game/pro_scen.msg:225800 game/pro_scen.msg:225900 game/pro_scen.msg:226000
#: game/pro_scen.msg:226100 game/pro_scen.msg:226200 game/pro_scen.msg:226300
#: game/pro_scen.msg:226400 game/pro_scen.msg:226500 game/pro_scen.msg:226600
#: game/pro_scen.msg:226700
msgid "Glowing Rocks"
msgstr "Rocce luminescenti"

#: game/pro_scen.msg:223101 game/pro_scen.msg:223201 game/pro_scen.msg:223801
msgid "A pile of glowing rocks. Not very interesting."
msgstr "Un mucchio di rocce luminescenti. Non molto interessante."

#: game/pro_scen.msg:223301
msgid "A small pile of glowing rocks. Not in the least bit interesting to you."
msgstr ""
"Un piccolo mucchio di rocce luminescenti. Assolutamente non interessante per "
"te."

#: game/pro_scen.msg:223401 game/pro_scen.msg:223501 game/pro_scen.msg:223601
#: game/pro_scen.msg:223701
msgid "A very small pile of glowing rocks."
msgstr "Un piccolissimo mucchio di rocce luminescenti."

#: game/pro_scen.msg:223900 game/pro_scen.msg:224000 game/pro_scen.msg:224100
#: game/pro_scen.msg:224200 game/pro_scen.msg:224600
msgid "Glowing Egg Shell"
msgstr "Guscio d'uovo luminescente"

#: game/pro_scen.msg:223901 game/pro_scen.msg:224001 game/pro_scen.msg:224101
#: game/pro_scen.msg:224201 game/pro_scen.msg:224601
msgid "Pieces of a broken egg shell. It glows!"
msgstr "Pezzi di un guscio d'uovo rotto. E' luminescente!"

#: game/pro_scen.msg:224300 game/pro_scen.msg:224400 game/pro_scen.msg:224500
msgid "Small glowing rocks"
msgstr "Piccole rocce luminescenti"

#: game/pro_scen.msg:224301 game/pro_scen.msg:224401 game/pro_scen.msg:224501
msgid "Scattered small glowing rocks."
msgstr "Piccole rocce luminescenti sparse."

#: game/pro_scen.msg:224700 game/pro_scen.msg:224800
msgid "Glowing Wood Planks"
msgstr "Assi di legno luminescenti"

#: game/pro_scen.msg:224901
msgid ""
"It's an old, glowing, fairly rickety ladder. It looks like it will barely "
"support your weight."
msgstr ""
"E' una vecchia scala luminescente e piuttosto traballante. Sembra poter "
"sostenere a malapena il tuo peso."

#: game/pro_scen.msg:225101
msgid "You study the glowing rocks for a while, but they never move."
msgstr "Studi le rocce luminescenti per un po', ma non si muovono."

#: game/pro_scen.msg:225201
msgid ""
"You keep a close eye on these glowing rocks, in case they move to attack you."
msgstr ""
"Tieni d'occhio queste rocce luminescenti, nel caso si muovano per attaccarti."

#: game/pro_scen.msg:225301
msgid "A large pile of glowing rocks. They look radioactive."
msgstr "Un grosso mucchio di rocce luminescenti. Sembrano radioattive."

#: game/pro_scen.msg:225401 game/pro_scen.msg:225501 game/pro_scen.msg:226001
msgid "A small pile of glowing rocks."
msgstr "Un piccolo mucchio di rocce luminescenti."

#: game/pro_scen.msg:225601
msgid "A large pile of glowing rocks."
msgstr "Un grosso mucchio di rocce luminescenti."

#: game/pro_scen.msg:225701
msgid ""
"A very large pile of glowing rocks. They look dangerous just sitting there."
msgstr ""
"Un enorme mucchio di rocce luminescenti. Sembrano pericolose anche solo "
"stando li'."

#: game/pro_scen.msg:225801
msgid ""
"A large pile of glowing rocks. If you look closely, you can see the faces of "
"little old men in the sides of the stones."
msgstr ""
"Un grosso mucchio di rocce luminescenti. Se guardi da vicino, puoi vedere "
"facce di vecchietti sui lati delle pietre."

#: game/pro_scen.msg:225901
msgid "Rocks, rocks, rocks! Everywhere you look, glowing rocks!"
msgstr "Rocce, rocce, rocce! Ovunque guardi, rocce luminescenti!"

#: game/pro_scen.msg:226800 game/pro_scen.msg:226900 game/pro_scen.msg:227000
#: game/pro_scen.msg:227100 game/pro_scen.msg:227200 game/pro_scen.msg:227300
msgid "Glowing Wall"
msgstr "Parete luminescente"

#: game/pro_scen.msg:227400 game/pro_scen.msg:227500 game/pro_scen.msg:227600
#: game/pro_scen.msg:227700
msgid "Glowing Drain"
msgstr "Scarico luminescente"

#: game/pro_scen.msg:227501
msgid ""
"You can barely make out some movement behind the grate covering this drain. "
"You can see small green glowing eyes peering back at you. Rat eyes."
msgstr ""
"Riesci a malapena a distinguere dei movimenti dietro la grata che copre "
"questo scarico. Vedi dei piccoli occhi verdi e luminescenti che ti fissano. "
"Occhi di ratto."

#: game/pro_scen.msg:227800 game/pro_scen.msg:227900 game/pro_scen.msg:228000
msgid "Grimy Bed"
msgstr "Letto sudicio"

#: game/pro_scen.msg:228100 game/pro_scen.msg:228200 game/pro_scen.msg:228300
#: game/pro_scen.msg:228400 game/pro_scen.msg:228500 game/pro_scen.msg:228600
#: game/proto.msg:100
msgid "Glass"
msgstr "Vetro"

#: game/pro_scen.msg:228101 game/pro_scen.msg:228201 game/pro_scen.msg:228301
msgid "This glass is difficult to see through."
msgstr "E' difficile vedere attraverso questo vetro."

#: game/pro_scen.msg:228401 game/pro_scen.msg:228501 game/pro_scen.msg:228601
msgid "This glass is barely transparent."
msgstr "Questo vetro e' appena trasparente."

#: game/pro_scen.msg:228700 game/pro_scen.msg:228800 game/scrname.msg:412
#: game/scrname.msg:1486
msgid "Metal Door"
msgstr "Porta in Metallo"

#: game/pro_scen.msg:228701 game/pro_scen.msg:228801
msgid "A sturdy metal door."
msgstr "Una robusta porta di metallo."

#: game/pro_scen.msg:228900 game/pro_scen.msg:229000
msgid "Guards Shack"
msgstr "Baracca della guardia"

#: game/pro_scen.msg:228901 game/pro_scen.msg:229001
msgid "A run down guards shack."
msgstr "Una baracca delle guardie fatiscente."

#: game/pro_scen.msg:229100
msgid "Green Bubbling Liquid"
msgstr "Liquido verde ribollente"

#: game/pro_scen.msg:229101
msgid "Green bubbling liquid. It smells strange."
msgstr "Un liquido verde ribollente. Ha un odore strano."

#: game/pro_scen.msg:229200 game/pro_scen.msg:229400
msgid "Heavy Laser Tower"
msgstr "Torretta laser pesante"

#: game/pro_scen.msg:229201 game/pro_scen.msg:229401
msgid "The laser turret rests on this concrete tower."
msgstr "La torretta laser poggia su questa torre di cemento."

#: game/pro_scen.msg:229800
msgid "Film Poster"
msgstr "Poster cinematografico"

#: game/pro_scen.msg:229801
msgid "An old tatered film poster. \"Hobo With a Shotgun\"."
msgstr "Un vecchio poster cinematografico logoro. “Hobo With a Shotgun”."

#: game/pro_scen.msg:229900 game/pro_scen.msg:230000
msgid "An odd looking creature"
msgstr "Una creatura dall'aspetto strano"

#: game/pro_scen.msg:229901 game/pro_scen.msg:230001
msgid "A dead body with plant growth wrapped around it."
msgstr "Un cadavere avvolto da crescite vegetali."

#: game/pro_tile.msg:100
msgid "Tile Eraser"
msgstr "Cancella Piastrelle"

#: game/pro_tile.msg:1100
msgid "Inviso Roof"
msgstr "Tetto Inviso"


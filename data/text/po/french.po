#: game/pro_scen.msg:79900 game/scrname.msg:405 game/scrname.msg:1088
msgid "Table"
msgstr "Table"

#: game/pro_item.msg:16601 game/pro_item.msg:16701
msgid "A generic table. Holds stuff off the ground."
msgstr "Une table normale. Evite de tout poser par terre."

#: game/pro_item.msg:16800 game/pro_item.msg:16900 game/pro_item.msg:17000
#: game/pro_item.msg:17100 game/pro_item.msg:17200 game/pro_item.msg:17300

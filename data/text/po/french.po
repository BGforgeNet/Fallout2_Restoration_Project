#: game/pro_misc.msg:4400 game/pro_misc.msg:4500 game/pro_misc.msg:4600
#: game/scrname.msg:619
msgid "Exit Grid"
msgstr "Zone de sortie"

#: game/pro_misc.msg:2500
msgid "Grenade"
msgstr "Grenade"

#: game/pro_misc.msg:4700
msgid "Robot Rocket"
msgstr "Roquette pour robots"

#: game/pro_misc.msg:4800
msgid "Ka-Pow!"
msgstr "Ka-Pow !"

#: game/pro_misc.msg:5000
msgid "Dual Plasma Ball"
msgstr "Balle à plasma double"

#: game/pro_scen.msg:100
msgid "Burning Metal Barrel"
msgstr "Baril en métal en feu"

#: game/pro_scen.msg:101
msgid "The barrel contains burning paper and other flaming refuse."
msgstr "Le baril contient du papier et autres résidus en feu."

#: game/pro_scen.msg:200 game/scrname.msg:126
msgid "Wooden Door"
msgstr "Porte en bois"

#: game/pro_scen.msg:201
msgid "A door, made from wood."
msgstr "Une porte en bois."

#: game/pro_scen.msg:300 game/pro_scen.msg:400
msgid "Wooden Table"
msgstr "Table en bois"

#: game/pro_scen.msg:301 game/pro_scen.msg:401
msgid "A table, made from wood."
msgstr "Une table en bois."

#: game/pro_scen.msg:500 game/pro_scen.msg:600 game/pro_scen.msg:39600
#: game/pro_scen.msg:39700
msgid "Metal Barrel"
msgstr "Baril en métal"

#: game/pro_scen.msg:501 game/pro_scen.msg:601
msgid "An old barrel, made from steel."
msgstr "Un vieux baril en tôle."

#: game/pro_scen.msg:700 game/pro_scen.msg:196200 game/pro_scen.msg:230500
#: game/pro_scen.msg:230600
msgid "Stack of Tires"
msgstr "Pile de pneus"

#: game/pro_scen.msg:701 game/pro_scen.msg:196201 game/pro_scen.msg:230501
#: game/pro_scen.msg:230601
msgid ""
"A stack of ancient rubber tires. They have vulcanized and hardened, probably "
"due to the heat."
msgstr ""
"Une pile d'anciens pneu de caoutchouc. Ils sont endommagés et durcis, "
"probablement à cause de la chaleur."

#: game/pro_scen.msg:800 game/pro_scen.msg:98900 game/pro_scen.msg:193100
#: game/pro_scen.msg:193200 game/pro_scen.msg:200900 game/pro_scen.msg:207300
#: game/pro_scen.msg:210000 game/scrname.msg:742 game/scrname.msg:1021
#: game/scrname.msg:1524
msgid "Security Door"
msgstr "Portes de sécurité"

#: game/pro_scen.msg:801
msgid ""
"This door looks very secure. It provides protection from the outside world "
"elements and dangerous creatures."
msgstr ""
"Cette porte semble très solide. Elle protège des éléments du monde extérieur "
"et des créatures dangereuses."

#: game/pro_scen.msg:900 game/pro_scen.msg:1100 game/pro_scen.msg:1200
#: game/pro_scen.msg:16000 game/pro_scen.msg:16100 game/pro_scen.msg:16200
#: game/pro_scen.msg:16300 game/pro_scen.msg:55300 game/pro_scen.msg:55400

msgstr "T'as l'air en forme, mon coeur."

#: dialog/ncstulit.msg:230
msgid "Need some new talent..."
msgstr "J'ai besoin de nouveaux talents..."

#: dialog/ncstulit.msg:231
msgid "Sorry lead asses..."
msgstr "Je regrette, bande de nazes..."

#: dialog/ncstulit.msg:232

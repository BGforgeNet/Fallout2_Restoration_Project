msgstr "melon"

#: dialog/zislots.msg:1101
msgid "cherries"
msgstr "cerises"

#: dialog/zislots.msg:1102
msgid "oranges"
msgstr "oranges"

#: dialog/zislots.msg:1103
msgid "plums"
msgstr "prunes"

#: dialog/zislots.msg:1104
msgid "bells"
msgstr "cloches"

#: dialog/zislots.msg:1105

msgstr "Mon visage ! Mon visage !"

#: game/cmbatai2.msg:1001 game/combatai.msg:1001
msgid "Ow! That hurt!"
msgstr "Oh ! Ca fait mal !"

#: game/cmbatai2.msg:1002 game/cmbatai2.msg:32702 game/combatai.msg:1002
#: game/combatai.msg:32702
msgid "Ouch! I need some ice for my head."
msgstr "Aie ! Il vaut mieux que je mette de la glace sur ma tête !"

#: game/cmbatai2.msg:1010 game/cmbatai2.msg:1020 game/cmbatai2.msg:32010
#: game/cmbatai2.msg:32020 game/cmbatai2.msg:32710 game/cmbatai2.msg:32720
#: game/combatai.msg:1010 game/combatai.msg:1020 game/combatai.msg:32010
#: game/combatai.msg:32020 game/combatai.msg:32710 game/combatai.msg:32720

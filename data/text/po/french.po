#: game/pro_wall.msg:8400 game/pro_wall.msg:175600
msgid "Pipe"
msgstr "Tuyau"

#: game/pro_scen.msg:41700 game/pro_scen.msg:42000 game/pro_scen.msg:90100
#: game/pro_scen.msg:90200 game/pro_scen.msg:193300 game/pro_scen.msg:193400
#: game/pro_scen.msg:193500 game/pro_scen.msg:193600 game/pro_scen.msg:193700
msgid "Elevator Shaft"
msgstr "Conduit d'ascenseur"

#: game/pro_scen.msg:41701
msgid "Part of an elevator system."
msgstr "Partie d'un ascenseur."

#: game/pro_scen.msg:41800
msgid "Air Shaft"
msgstr "Cage d'ascenseur"

#: game/pro_scen.msg:41801
msgid "An air shaft that stretches deep into the ship. It has been damaged."
msgstr "Cage d'ascenseur qui s'étend jusqu'au sol. Elle a été endommagée."

#: game/pro_scen.msg:41901
msgid "An elevator. Use it to go up and down between levels."
msgstr "Ascenseur que tu peux utiliser pour passer d'un étage à l'autre."

#: game/pro_scen.msg:42001
msgid ""
"An elevator shaft that stretches deep into the ground. It has been damaged."
msgstr "Cage d'ascenseur qui s'étend jusqu'au sol. Elle a été endommagée."

#: game/pro_scen.msg:42100 game/pro_scen.msg:47000 game/scrname.msg:677
#: game/scrname.msg:996 game/scrname.msg:1525
msgid "Elevator Door"
msgstr "Porte d'ascenseur"

#: game/pro_scen.msg:42101
msgid ""
"This door leads to the elevator car. If you want to use the elevator, you "
"must first open this door."
msgstr ""
"Cette porte mène à la cage d'ascenseur. Si tu veux utiliser l'ascenseur, tu "
"dois d'abord ouvrir cette porte."

#: game/pro_scen.msg:42201
msgid "A metal pipe. Further details are not important."
msgstr "Tuyau en métal. Les autres détails ne sont pas importants."

#: game/pro_scen.msg:42801 game/pro_scen.msg:42901 game/pro_scen.msg:49901
#: game/pro_scen.msg:50001
msgid "A pile of rocks. Not very interesting."
msgstr "Un tas de cailloux. Pas très intéressant."

#: game/pro_scen.msg:43001 game/pro_scen.msg:50101
msgid "A small pile of rocks. Not in the least bit interesting to you."
msgstr "Un petit tas de cailloux. Pas du tout intéressant."

#: game/pro_scen.msg:43101 game/pro_scen.msg:43201 game/pro_scen.msg:43301
#: game/pro_scen.msg:43401 game/pro_scen.msg:43501 game/pro_scen.msg:50201
#: game/pro_scen.msg:50301 game/pro_scen.msg:50401
msgid "A very small pile of rocks."
msgstr "Un tout petit tas de cailloux."

#: game/pro_scen.msg:43601
msgid ""
"This vault door is very similar to the one at Vault-13. The door mechanism "
"has been disabled."
msgstr ""
"Cette porte d'abri ressemble beaucoup à celle de l'Abri 13. Le mécanisme de "
"la porte à été désactivé."

#: game/pro_scen.msg:43701 game/pro_scen.msg:43801
msgid ""
"A finely constructed wooden door, reinforced with ornate metal braces of an "
"almost hypnotic design."
msgstr ""
"Très jolie porte en bois, renforcée par les entretoises en métal décoré d'un "
"motif quasi-hypnotique."

#: game/pro_scen.msg:43900 game/pro_scen.msg:44000 game/pro_scen.msg:44100
#: game/pro_scen.msg:44200 game/pro_scen.msg:44300 game/pro_scen.msg:44400
#: game/pro_scen.msg:44500 game/pro_scen.msg:44600
msgid "Vats"
msgstr "Cuves"

#: game/pro_scen.msg:43901 game/pro_scen.msg:44001 game/pro_scen.msg:44101
#: game/pro_scen.msg:44201 game/pro_scen.msg:44301 game/pro_scen.msg:44401
#: game/pro_scen.msg:44501 game/pro_scen.msg:44601
msgid ""
"A complex of some sort. You are not sure, but you can see large vats of a "
"greenish goo that looks vaguely important."
msgstr ""
"Sorte de complexe. Tu ne sais pas vraiment, mais tu distingues de grosses "
"cuves de substances collantes verdâtres qui semblent vaguement importantes."

#: game/pro_scen.msg:44801
msgid "A security door. Looks heavily armored."
msgstr "Porte de sécurité apparemment lourdement blindée."

#: game/pro_scen.msg:44900
msgid "Nuclear Warhead"
msgstr "Ogive nucléaire"

#: game/pro_scen.msg:45100 game/pro_scen.msg:45200 game/pro_scen.msg:45300
#: game/pro_scen.msg:45400 game/pro_scen.msg:45500 game/pro_scen.msg:45600
#: game/pro_scen.msg:45700 game/pro_scen.msg:45800 game/pro_scen.msg:45900
#: game/pro_scen.msg:46000
msgid "Craps Table"
msgstr "Table de jeu"

#: game/pro_scen.msg:45101 game/pro_scen.msg:45201 game/pro_scen.msg:45301
#: game/pro_scen.msg:45401 game/pro_scen.msg:45501 game/pro_scen.msg:45601
#: game/pro_scen.msg:45701 game/pro_scen.msg:45801 game/pro_scen.msg:45901
#: game/pro_scen.msg:46001 game/pro_scen.msg:54601 game/pro_scen.msg:54701
#: game/pro_scen.msg:54801 game/pro_scen.msg:54901 game/pro_scen.msg:55001
msgid "This is a gambling table."
msgstr "Voici une table de jeu."

#: game/pro_scen.msg:46101
msgid "A small rock, completely uninteresting in the context of this story."
msgstr ""
"Un petit rocher, complètement sans intérêt dans le cadre de cette histoire."

#: game/pro_scen.msg:46500 game/pro_scen.msg:46600 game/scrname.msg:477
#: game/scrname.msg:514
msgid "Slot Machine"
msgstr "Machine à sous"

#: game/pro_scen.msg:46501 game/pro_scen.msg:46601

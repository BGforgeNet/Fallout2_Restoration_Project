msgstr "Redding"

#: dialog/eccvnmst.msg:202 game/map.msg:115 game/map.msg:116 game/map.msg:117
#: game/map.msg:1504
msgid "Vault City"
msgstr "La Cité de l'Abri"

#: dialog/eccvnmst.msg:203
msgid "NCR"
msgstr "RNC"

#: dialog/eccvnmst.msg:204 game/map.msg:1506
msgid "Broken Hills"
msgstr "Les Collines Brisées"

#: dialog/eccvnmst.msg:205 game/map.msg:1505 game/scrname.msg:300
#: game/scrname.msg:1458
msgid "Gecko"
msgstr "Gecko"

#: dialog/eccvnmst.msg:206 game/map.msg:1514

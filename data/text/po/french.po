msgid "Ow, my arm!"
msgstr "Oh, mon bras !"

#: game/cmbatai2.msg:1012 game/cmbatai2.msg:1621 game/cmbatai2.msg:32012
#: game/cmbatai2.msg:32712 game/cmbatai2.msg:36021 game/combatai.msg:1012
#: game/combatai.msg:1621 game/combatai.msg:32012 game/combatai.msg:32712
#: game/combatai.msg:36021
msgid "You broke my arm!"
msgstr "Tu m'as cassé l'bras !"

#: game/cmbatai2.msg:1021 game/cmbatai2.msg:32021 game/cmbatai2.msg:32721
#: game/cmbatai2.msg:33221 game/combatai.msg:1021 game/combatai.msg:32021
#: game/combatai.msg:32721 game/combatai.msg:33221
msgid "Wahhhh!"
msgstr "Ahhhh !"

#: game/cmbatai2.msg:1022 game/cmbatai2.msg:32022 game/combatai.msg:1022
#: game/combatai.msg:32022
msgid "My God! My arm!"
msgstr "Mon Dieu ! Mon bras !"

#: game/cmbatai2.msg:1030 game/cmbatai2.msg:32730 game/combatai.msg:1030
#: game/combatai.msg:32730
msgid "Ow! That really hurt!"
msgstr "Oh ! Ca fait vraiment mal !"

#: game/cmbatai2.msg:1031 game/cmbatai2.msg:32731
msgid "I think I'm gonna faint"
msgstr "J'crois que j'vais tomber dans les pommes..."

#: game/cmbatai2.msg:1032 game/cmbatai2.msg:1132 game/cmbatai2.msg:1232
#: game/cmbatai2.msg:1235 game/cmbatai2.msg:32732 game/cmbatai2.msg:36641
#: game/combatai.msg:1032 game/combatai.msg:1135 game/combatai.msg:1232
#: game/combatai.msg:1235 game/combatai.msg:32732 game/combatai.msg:36641
#: game/combatai.msg:41610
msgid "Ouch!"
msgstr "Ouille !"


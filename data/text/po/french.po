#: game/proto.msg:104
msgid "Dirt"
msgstr "Terre"

#: game/pro_scen.msg:11101
msgid "A small pile of dirt, with a dead weed sticking out of it."
msgstr "Un peu de terre. Il en sort une mauvaise herbe morte."

#: game/pro_scen.msg:11201 game/pro_scen.msg:11301 game/pro_scen.msg:11401
#: game/pro_scen.msg:11901 game/pro_scen.msg:12001 game/pro_scen.msg:12101
#: game/pro_scen.msg:12201 game/pro_scen.msg:12301 game/pro_scen.msg:12401
msgid "A small pile of dirt."
msgstr "Un peu de terre."

#: game/pro_scen.msg:11500 game/pro_scen.msg:12500 game/pro_scen.msg:12600
#: game/pro_scen.msg:12700
msgid "Weed"
msgstr "Mauvaise herbe"

#: game/pro_scen.msg:11501
msgid "A small pile of dirt, with a dry weed sticking out of it."
msgstr "Un peu de terre. Il en sort une mauvaise herbe sèche."

#: game/pro_scen.msg:11601
msgid "A twisted piece of rusted metal."
msgstr "Morceau tordu de métal rouillé."

#: game/pro_scen.msg:11701
msgid "Some broken pieces of wood."
msgstr "Quelques morceaux de bois cassés."

#: game/pro_scen.msg:11801
msgid "A small pile of random junk."
msgstr "Petit tas de vieilleries en tout genre."

#: game/pro_scen.msg:12501 game/pro_scen.msg:12601 game/pro_scen.msg:12701
msgid "A generic desert weed."
msgstr "Mauvaise herbe générique du désert."

#: game/pro_scen.msg:12800
msgid "Blocking Hex (NoLight)"
msgstr "Blocking Hex (NoLight)"


#: dialog/sscrpdor.msg:109
msgid "Sorry, we don't need any of that."
msgstr ""

#: dialog/sscrpdor.msg:110
msgid "The door is bolted from the other side. There doesn't seem to be anything to pick."
msgstr ""

#: dialog/sscrpdor.msg:111
msgid "The door is flush to the frame and doesn't have anywhere to place a trap."
msgstr ""

#: dialog/sscrpdor.msg:112
msgid "The door creaks and breaks under the strain."

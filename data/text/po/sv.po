msgstr ""

#: dialog/ncrenesc.msg:243
msgid "Hey, I have a pair of glasses, if you want them."
msgstr ""

#: dialog/ncrenesc.msg:244
msgid "How's the glasses?"
msgstr ""

#: dialog/ncrenesc.msg:245
msgid "You know, there are decaf brands that taste just as good as the real thing."
msgstr ""

#: dialog/ncrenesc.msg:246
msgid "Man, am I in the wrong place. Goodbye."
msgstr ""

#: dialog/ncrenesc.msg:255
msgid "(Stares in shock.)"
msgstr ""

#: dialog/ncrenesc.msg:256
msgid ""
"...another postnatally-aborted wreck in a post-holocaust world replete with idiot man-children. (Raises his fists.)\n"

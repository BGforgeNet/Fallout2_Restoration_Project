#: dialog/ncjules.msg:1378
msgid "(Follow him.)"
msgstr ""

#: dialog/ncjules.msg:1385
msgid "H... hey. (Smiles uneasily. His cologne slams into you like a wave.) Name's Jules. What you need, my friend, huh? A..anything?"
msgstr ""


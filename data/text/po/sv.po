#: dialog/gcfolk.msg:260 dialog/gcfolk.msg:309
msgid "You're the best smoothskin I've ever known."
msgstr ""

#: dialog/gcfolk.msg:261
msgid "More glow-juice! More glow-juice!"
msgstr ""

#: dialog/gcfolk.msg:262
msgid "Gives us another, eh smoothy?"
msgstr ""

#: dialog/gcfolk.msg:263
msgid "Those poor muties in Broken Hills."
msgstr ""

#: dialog/gcfolk.msg:264
msgid "I heard that geckos are like us. Changed by the radiation."
msgstr ""

#: dialog/gcfolk.msg:265
msgid "We just cling to life here, like a little gecko on the wall."
msgstr ""

#: dialog/gcfolk.msg:266
msgid "I hear Skeeter's building a giant robot."
msgstr ""

#: dialog/gcfolk.msg:267
msgid "I heard that Chester's a spy for Vault City."

#: dialog/hcfranci.msg:117
msgid "How... exciting."
msgstr ""

#: dialog/hcfranci.msg:118
msgid "All right, thanks."
msgstr ""

#: dialog/hcfranci.msg:119
msgid "Human/mutant relations? What do you mean?"
msgstr ""

#: dialog/hcfranci.msg:120
msgid "I'm always ready. You wanna go?"
msgstr ""

#: dialog/hcfranci.msg:121
msgid "No, I'm just asking for my health."
msgstr ""

#: dialog/hcfranci.msg:122
msgid "Umm, no."
msgstr ""

#: dialog/hcfranci.msg:123
msgid "Of course I do."
msgstr ""

#: dialog/hcfranci.msg:124
msgid "[he sizes you up and gauges your musculature] I don't think so, pal. It'd just be a waste of my time. Piss off."
